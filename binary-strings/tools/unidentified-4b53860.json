                "type": [
                  "string",
                  "object",
                  "null"
                ],
                "properties": {
                  "inapplicable": {
                    "type": "string"
                  }
                },
                "required": [
                  "inapplicable"
                ],
                "additionalProperties": false
              },
              "pickup_location": {
                "type": [
                  "string",
                  "null"
                ]
              },
