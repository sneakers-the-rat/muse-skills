                "type": [
                  "string",
                  "object",
                  "null"
                ],
                "properties": {
                  "inapplicable": {
                    "type": "string"
                  }
                },
                "required": [
                  "inapplicable"
                ],
                "additionalProperties": false
              },
              "arrival": {
                "description": "The page text, its explanation that the term does not apply, or null when the checkout has no place for it. List a detail the checkout requires but has not settled in missing.",
