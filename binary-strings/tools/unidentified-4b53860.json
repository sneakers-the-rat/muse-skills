    "type": "object",
    "properties": {
      "tab": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
      },
      "purchase": {
        "description": "The current purchase facts. Include these unless recording only a purchase_outcome.",
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "merchant": {
            "description": "The merchant as the page names it. Null when the page names none, and the page's site stands for it.",
            "type": [
              "string",
              "null"
            ]
          },
          "merchant_country": {
            "type": [
              "string",
              "null"
            ]
          },
          "account": {
            "description": "The page text, its explanation that the term does not apply, or null when the checkout has no place for it. List a detail the checkout requires but has not settled in missing.",
            "type": [
              "string",
              "object",
              "null"
            ],
            "properties": {
              "inapplicable": {
                "type": "string"
              }
            },
            "required": [
              "inapplicable"
            ],
            "additionalProperties": false
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product": {
                  "type": "string"
                },
                "seller": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "variants": {
                  "description": "Each selected variant as Name: Value, such as Color: Blue.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "obligations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "unit_amount": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "line_total": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "product",
                "seller",
                "quantity",
                "variants",
                "obligations",
                "unit_amount",
                "line_total"
              ],
              "additionalProperties": false
            }
          },
          "charges": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "currency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "total": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "The displayed amount due now. Record any additional conditional charge separately."
              },
              "subtotal": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "conditional": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "amount": {
                    "description": "Maximum additional conditional amount for the whole purchase, in the checkout currency. Account for the applicable quantity when a fee is per person or item. Null when unknown or not applicable.",
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "terms": {
                    "description": "The conditions under which the merchant may collect the additional charge, as stated. Null when unknown or not applicable.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          },
