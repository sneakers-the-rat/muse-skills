                "description": "The observed shipping address. Partial addresses can be recorded; Shop Pay needs the complete address before payment."
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "obligations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payment": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "route": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "card",
                  "shop_pay",
                  "saved",
                  "none",
                  null
                ]
              },
              "method": {
                "description": "The page text, its explanation that the term does not apply, or null when not shown.",
                "type": [
                  "string",
                  "object",
                  "null"
                ],
                "properties": {
                  "inapplicable": {
                    "type": "string"
                  }
                },
                "required": [
                  "inapplicable"
                ],
                "additionalProperties": false
              },
              "saved_card": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "brand": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "last4": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "use_wallet": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "When Muse has not selected a wallet card: true offers the available wallet; false uses the supplied or entered card. Null or omission keeps this checkout's choice, defaulting to false. A later payment choice from Muse replaces it."
              },
              "valid_for_seconds": {
                "description": "Requested Link card lifetime after approval, in seconds; null uses the default. Keep the same duration unless payment timing changes.",
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 31536000
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "missing": {
        "description": "Unresolved purchase requirements. Omit or leave empty when the terms are ready, including when preparation will supply the card.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "status": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "draft",
          "ready",
          null
        ],
        "description": "Use draft while gathering facts, or ready when the purchase can proceed to review and payment. Omission records a draft."
      },
      "record_only": {
        "type": "boolean",
        "description": "Record the assessment without requesting cart review or payment. Defaults to false."
      },
      "purchase_outcome": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "placed",
              "not_placed",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "confirmation": {
            "type": [
              "object",
              "null"
            ],
