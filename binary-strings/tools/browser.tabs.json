{
  "name": "browser.tabs",
  "description": "List, open, select or close tabs in this browser window.\n\nOpen a tab at a URL you were given or have observed, or leave the URL out for a blank tab. Use the tab IDs the tool returns. All tabs share the window's browsing profile. Closing a tab does not undo anything already done in it.",
  "input_schema": {
    "type": "object",
    "properties": {
      "tab": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
      },
      "view": {
        "type": "string",
        "enum": [
          "auto",
          "text",
          "element"
        ]
      },
      "query": {
        "type": "string",
        "minLength": 1
      },
      "target": {
        "description": "An element reference from the current view.",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
          }
        },
        "required": [
          "ref"
        ],
        "additionalProperties": false
      },
      "fields": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "text",
            "value",
            "href",
            "image_url",
            "role",
            "name",
            "state"
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "listen": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600
      }
    },
    "required": [
      "tab"
    ],
    "additionalProperties": false
  }
}
