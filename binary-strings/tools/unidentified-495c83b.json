{
  "name": null,
  "description": "",
  "input_schema": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "list",
          "open",
          "select",
          "close"
        ]
      },
      "url": {
        "type": "string",
        "minLength": 1,
        "format": "uri",
        "pattern": "^https?://",
        "description": "With open: the page to load in the new tab."
      },
      "tab": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$",
        "description": "With select and close: the tab."
      }
    },
    "required": [
      "kind"
    ],
    "additionalProperties": false
  }
}
