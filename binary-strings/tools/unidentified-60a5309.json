{
  "name": null,
  "description": "",
  "input_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "needs_input",
          "blocked"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "reason": {
        "type": "string",
        "description": "Optional label for needs_input or blocked. Omit for completed or when no label fits; explain the situation in summary. For needs_input, use sign_in, verification_code, captcha, payment, approval, missing_information, decision, or other, or personal_agent_protocol when you stop because the site supports the Personal Agent Protocol. Payment means missing payment details or a payment choice; approval means permission for something outside the assignment, not the separate purchase approval. Use captcha only for an unsolved puzzle when the user can take over this browser and no other site will do. For blocked, use bot_wall, captcha_unsolved, ai_agent_refused, ip_blocked, rate_limited, sign_in_required, sign_in_rejected, not_available, site_error, site_unreachable, approval_denied, browser_failure, or order_unconfirmed. Use order_unconfirmed when the merchant's outcome remains unresolved after permitted verification and no user input can resolve it.",
        "enum": [
          "sign_in",
          "verification_code",
          "captcha",
          "payment",
          "approval",
          "missing_information",
          "decision",
          "other",
          "personal_agent_protocol",
          "bot_wall",
          "captcha_unsolved",
          "ai_agent_refused",
          "ip_blocked",
          "rate_limited",
          "sign_in_required",
          "sign_in_rejected",
          "not_available",
          "site_error",
          "site_unreachable",
          "approval_denied",
          "browser_failure",
          "order_unconfirmed"
        ]
      },
      "products": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "format": "uri",
              "pattern": "^https?://"
            },
            "image_url": {
              "type": "string",
              "minLength": 1,
              "format": "uri",
              "pattern": "^https://"
            },
            "availability": {
              "const": "in_stock"
            },
            "brand": {
              "type": "string",
              "minLength": 1
            },
            "price": {
              "type": "string",
              "minLength": 1
            },
            "sale_price": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
              },
              "minItems": 1
            }
          },
          "required": [
            "name",
            "url",
            "image_url",
            "availability"
          ],
          "additionalProperties": false
        },
        "minItems": 0
      },
      "artifacts": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
        },
        "minItems": 0,
        "uniqueItems": true
      }
    },
    "required": [
      "status",
      "summary"
    ],
    "additionalProperties": false
  }
}
