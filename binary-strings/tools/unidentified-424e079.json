{
  "name": null,
  "description": "",
  "input_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "needs_input",
          "blocked"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "reason": {
        "type": "string",
        "description": "Required for needs_input; optional for blocked; omit for completed. Name what stopped the task, as the tool description defines each label, and explain the situation in summary. For blocked, omit it when no label fits.",
        "enum": [
          "sign_in",
          "verification",
          "captcha_bot",
          "payment",
          "missing_info",
          "decision",
          "other",
          "personal_agent_protocol",
          "bot_wall",
          "ai_agent_refused",
          "captcha",
          "ip_or_rate_limit",
          "site_error",
          "item_unavailable",
          "order_unconfirmed",
          "out_of_stock",
          "information_not_available",
          "not_eligible",
          "approval_denied",
          "browser_failure",
          "refusal"
        ]
      },
      "products": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "format": "uri",
              "pattern": "^https?://"
            },
            "image_url": {
              "type": "string",
              "minLength": 1,
              "format": "uri",
              "pattern": "^https://"
            },
            "availability": {
              "const": "in_stock"
            },
            "brand": {
              "type": "string",
              "minLength": 1
            },
            "price": {
              "type": "string",
              "minLength": 1
            },
            "sale_price": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
              },
              "minItems": 1
            }
          },
          "required": [
            "name",
            "url",
            "image_url",
            "availability"
          ],
          "additionalProperties": false
        },
        "minItems": 0
      },
      "artifacts": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
        },
        "minItems": 0,
        "uniqueItems": true
      }
    },
    "required": [
      "status",
      "summary"
    ],
    "additionalProperties": false
  }
}
