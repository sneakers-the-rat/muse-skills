[Unit]
Description=com.hatch.www-proxy socket
ConditionPathExists=!${keep_services_down_early_marker}

[Socket]
ListenStream=/run/hatch/www-proxy/www.sock
DirectoryMode=0755
SocketUser=root
SocketGroup=root
# PeerAcl admits only the host authd and Stefi services.
SocketMode=0666
RemoveOnStop=true
FlushPending=no

[Install]
WantedBy=sockets.target