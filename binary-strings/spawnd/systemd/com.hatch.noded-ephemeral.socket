[Unit]
Description=com.hatch.noded device-data ephemeral payload socket
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${host_bin_dir}/hatch-noded

[Socket]
# Pathname access is deliberately broad enough for the socket-activated
# device-data worker. Noded's PeerAcl admits only its exact template cgroup.
ExecStartPre=+/usr/bin/install -d -m 0755 -o root -g root /run/hatch
ExecStartPre=+/usr/bin/install -d -m 0755 -o root -g root /run/hatch/noded
ListenStream=/run/hatch/noded/ephemeral.sock
DirectoryMode=0755
SocketUser=${noded_user}
SocketGroup=${noded_group}
SocketMode=0666
FileDescriptorName=ephemeral
Service=com.hatch.noded.service
RemoveOnStop=true
ExecStartPost=+/bin/chmod 0666 /run/hatch/noded/ephemeral.sock

[Install]
WantedBy=sockets.target