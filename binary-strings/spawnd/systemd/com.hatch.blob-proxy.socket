[Unit]
Description=com.hatch.blob-proxy socket
DefaultDependencies=no
ConditionKernelCommandLine=!jarvis_cvm=true
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${host_bin_dir}/hatch-blob-proxy
After=com.hatch.db-preflight.service
Wants=com.hatch.db-preflight.service
PartOf=hatch-rv.target com.hatch.blob-proxy.service
Before=shutdown.target
Conflicts=shutdown.target

[Socket]
ExecStartPre=/usr/bin/systemctl is-active --quiet com.hatch.db-preflight.service
ListenStream=/run/hatch/blob-proxy/blob.sock
DirectoryMode=0755
SocketUser=root
SocketGroup=root
SocketMode=0666
RemoveOnStop=true
FlushPending=no

[Install]
WantedBy=hatch-rv.target