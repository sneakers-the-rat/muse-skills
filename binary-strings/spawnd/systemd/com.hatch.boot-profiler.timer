[Unit]
Description=Hatch per-boot systemd unit profiler timer
ConditionPathExists=!${keep_services_down_early_marker}
PartOf=hatch-rv.target

[Timer]
# Fire once, ~90s after this timer activates (i.e. after hatch-rv.target is
# reached), so app units have started before we snapshot. The collector also
# waits for `systemctl is-system-running`. RV-coupled, so WantedBy the RV target
# (never timers.target, which is reached before the reliable volume attaches).
OnActiveSec=90s
AccuracySec=10s
Unit=com.hatch.boot-profiler.service

[Install]
WantedBy=hatch-rv.target