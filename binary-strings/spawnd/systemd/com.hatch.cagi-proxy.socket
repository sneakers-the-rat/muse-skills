[Unit]
DefaultDependencies=no
Description=com.hatch.cagi-proxy socket
ConditionPathExists=!${keep_services_down_early_marker}
After=com.hatch.host-path-setup.service
Requires=com.hatch.host-path-setup.service
PartOf=com.hatch.cagi-proxy.service hatch-rv.target

[Socket]
ListenStream=/run/hatch/cagi-proxy/cagi.sock
DirectoryMode=0755
SocketUser=${stefi_proxy_user}
SocketGroup=${proxy_clients_group}
SocketMode=0660
RemoveOnStop=true
ExecStartPost=+/bin/chmod 0660 /run/hatch/cagi-proxy/cagi.sock

[Install]
WantedBy=hatch-rv.target