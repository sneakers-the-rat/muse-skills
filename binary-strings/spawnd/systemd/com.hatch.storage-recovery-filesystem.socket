[Unit]
Description=com.hatch.storage-recovery-filesystem socket
# The listener itself is mount-independent and starts with the recovery API.
# The activated helper service, not this socket, owns the concrete RV mount
# dependencies. This keeps recovery reachable when normal RV setup fails.
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${host_bin_dir}/hatch-rescuectl

[Socket]
ListenStream=/run/hatch/storage-recovery/filesystem.sock
FileDescriptorName=storage-recovery-filesystem
Service=com.hatch.storage-recovery-filesystem.service
SocketUser=root
SocketGroup=${rescue_group}
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=sockets.target