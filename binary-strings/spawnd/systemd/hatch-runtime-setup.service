[Unit]
Description=Hatch Runtime Setup
# Before=hatch-rv.target so the units are staged and yolk is reachable pre-RV.
After=hatch-init.service hatch-tls-selfsign.service
Before=hatch-rv.target
ConditionPathIsDirectory=/opt/hatch/etc/systemd

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/hatch/bin/hatch-runtime-setup
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target