[Unit]
Description=Hatch host proxy service slice

[Slice]
# Keep this unit's storage cost attributable. Without IO accounting the
# kernel counters vanish with the cgroup when the unit stops, so a
# short-lived unit's IO can only ever be measured while it is still
# running -- which is exactly when nobody is looking.
IOAccounting=true
CPUQuota=200%
MemoryMax=2G
TasksMax=4096