[Unit]
Description=com.hatch.rescue-systemctl socket
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${host_bin_dir}/hatch-rescue-systemctl

[Socket]
ListenStream=/run/hatch/rescue/systemctl.sock
Accept=yes
SocketUser=root
SocketGroup=${rescue_group}
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
ExecStartPost=+/bin/chmod 0660 /run/hatch/rescue/systemctl.sock

[Install]
WantedBy=sockets.target