[Unit]
Description=Hatch browser cell slice

[Slice]
# Keep this unit's storage cost attributable. Without IO accounting the
# kernel counters vanish with the cgroup when the unit stops, so a
# short-lived unit's IO can only ever be measured while it is still
# running -- which is exactly when nobody is looking.
IOAccounting=true
MemoryAccounting=yes
CPUAccounting=yes
TasksAccounting=yes
CPUWeight=25
MemoryHigh=3G
MemoryMax=3584M
MemorySwapMax=0
TasksMax=4096
# No IPAddressAllow= here or in hatch.slice: systemd adds a parent slice's
# allow list to every unit in it, and the test-VM browser egress lock then
# refuses the browser cell
# (hatch-engine/crates/hatch-browser-lease/docs/browser-egress.md).