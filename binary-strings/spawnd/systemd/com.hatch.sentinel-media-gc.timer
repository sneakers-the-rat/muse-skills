[Unit]
Description=Hatch Sentinel media copy garbage collection timer
ConditionPathExists=!${keep_services_down_early_marker}
DefaultDependencies=no
RequiresMountsFor=${var_lib_dir}/sentinel/egress
PartOf=hatch-rv.target

[Timer]
OnActiveSec=1s
OnUnitInactiveSec=1h
AccuracySec=1s
RandomizedDelaySec=30s
Unit=com.hatch.sentinel-media-gc.service

[Install]
WantedBy=hatch-rv.target