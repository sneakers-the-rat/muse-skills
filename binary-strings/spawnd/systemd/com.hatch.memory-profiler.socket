[Unit]
Description=Hatch memory profiler socket
ConditionPathExists=!${keep_services_down_early_marker}
ConditionKernelCommandLine=!jarvis_cvm=true

[Socket]
ListenStream=/run/hatch/memory-profiler/profile.sock
FileDescriptorName=memory-profiler
Service=com.hatch.memory-profiler.service
SocketUser=root
SocketGroup=root
# The connect supervisor runs as cell root mapped to host UID 131072, without
# the host root group. PeerAcl admits only its protected daemon service cgroup.
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=true
FlushPending=no

[Install]
WantedBy=sockets.target