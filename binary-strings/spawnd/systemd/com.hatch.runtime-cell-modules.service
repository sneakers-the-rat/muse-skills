[Unit]
Description=com.hatch.runtime-cell-modules
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${runtime_cell_dir}/require-modules.sh
# Host-only kernel module preload does not need the RV. Run it during normal
# VM boot so replacement VMs do not pay this cost after hatch-rv.target.
DefaultDependencies=yes

[Service]
Type=oneshot
RemainAfterExit=yes
Slice=hatch-runtime.slice
ExecStart=+${runtime_cell_dir}/require-modules.sh

[Install]
WantedBy=multi-user.target