[Unit]
Description=Hatch Central Blackhole client filter refresh timer
ConditionPathExists=!${keep_services_down_early_marker}
DefaultDependencies=no
PartOf=hatch-rv.target

[Timer]
OnActiveSec=1s
OnUnitInactiveSec=1h
AccuracySec=1s
# A fresh filter makes the job a no-op without calling WWW, so restarts
# across the fleet don't stampede; boot gets its first filter quickly.
RandomizedDelaySec=30s
Unit=com.hatch.central-blackhole-filter.service

[Install]
WantedBy=hatch-rv.target