[Unit]
Description=com.hatch.daemon voice-speak socket
ConditionPathExists=!${keep_services_down_early_marker}

[Socket]
ExecStartPre=+/usr/bin/install -d -m 0755 -o root -g root /run/hatch
ExecStartPre=+/bin/sh -c 'if getent group hatch-w-tts >/dev/null 2>&1; then exec /usr/bin/install -d -m 0750 -o root -g hatch-w-tts /run/hatch/voice-speak; fi; exec /usr/bin/install -d -m 0700 -o root -g root /run/hatch/voice-speak'
ListenStream=/run/hatch/voice-speak/voice-speak.sock
Service=com.hatch.daemon.service
SocketUser=${daemon_user}
SocketGroup=${proxy_clients_group}
SocketMode=0660
RemoveOnStop=true

[Install]
WantedBy=sockets.target