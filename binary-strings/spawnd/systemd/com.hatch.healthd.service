[Unit]
Description=com.hatch.healthd
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${host_bin_dir}/hatch-healthd

[Service]
Type=simple
User=${healthd_user}
Group=${shared_group}
SupplementaryGroups=${proxy_clients_group} ${daemon_group}
Slice=hatch-core.slice
PermissionsStartOnly=true
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=default
ProcSubset=all
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run
InaccessiblePaths=-/etc/hatch/credentials
Environment=JARVIS_HOME=${jarvis_home}
Environment=PATH=${host_bin_dir}:${image_bin_dir}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=${env_file}
EnvironmentFile=-${env_override_file}
ExecStartPre=+/usr/bin/install -d -m 0755 -o root -g root /run/hatch
ExecStartPre=+/usr/bin/install -d -m 0711 -o ${healthd_user} -g ${shared_group} /run/hatch/healthd
ExecStart=${host_bin_dir}/hatch-healthd
SyslogIdentifier=hatch-healthd
Restart=always
RestartSec=5
TimeoutStopSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target