[Unit]
ConditionPathExists=/usr/lib/hatch/upload-store-home.tmpfiles
DefaultDependencies=no
Description=com.hatch.upload-store socket
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${host_bin_dir}/hatch-upload-store
# Image-owned capability marker; older images cannot serve private uploads.
After=com.hatch.host-path-setup.service
Requires=com.hatch.host-path-setup.service
PartOf=hatch-rv.target

[Socket]
ListenStream=/run/hatch/upload-store/store.sock
FileDescriptorName=upload-store
Service=com.hatch.upload-store.service
SocketUser=root
SocketGroup=root
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=hatch-rv.target