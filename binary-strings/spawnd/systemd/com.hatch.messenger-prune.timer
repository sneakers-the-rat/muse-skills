[Unit]
Description=com.hatch.messenger-prune timer
ConditionPathExists=!${keep_services_down_early_marker}
# Worker prep pulls this timer only after execution-ready or first worker use.
# Requiring and ordering after prep prevents a Persistent= catch-up from racing
# state repair or running after a failed repair.
DefaultDependencies=no
Requires=com.hatch.privsep-worker-prep.service
After=hatch-rv.target com.hatch.privsep-worker-prep.service
PartOf=hatch-rv.target

[Timer]
OnCalendar=*-*-* 03:00:00
Unit=com.hatch.messenger-prune.service
Persistent=true