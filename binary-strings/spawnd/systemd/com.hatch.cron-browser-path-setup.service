[Unit]
Description=Hatch Cron browser paths
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${host_bin_dir}/browser-path-setup.sh
After=hatch-rv.target com.hatch.host-path-setup.service
Requires=com.hatch.host-path-setup.service
PartOf=hatch-rv.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=+${host_bin_dir}/browser-path-setup.sh cron
SyslogIdentifier=hatch-cron-browser-path-setup