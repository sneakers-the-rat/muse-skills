[Unit]
DefaultDependencies=no
Description=com.hatch.disk-usage socket
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${host_bin_dir}/hatch-rescuectl
After=com.hatch.host-path-setup.service
Requires=com.hatch.host-path-setup.service
PartOf=hatch-rv.target

[Socket]
ListenStream=/run/hatch/disk-usage/disk-usage.sock
FileDescriptorName=disk-usage
Service=com.hatch.disk-usage.service
SocketUser=root
SocketGroup=${rescue_group}
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=hatch-rv.target