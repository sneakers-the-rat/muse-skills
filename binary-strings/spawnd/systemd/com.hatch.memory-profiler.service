[Unit]
Description=Hatch live heap profile collector
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${host_bin_dir}/hatch-memory-profiler
ConditionKernelCommandLine=!jarvis_cvm=true
After=com.hatch.memory-profiler.socket
Requires=com.hatch.memory-profiler.socket
Before=com.hatch.daemon.service

[Service]
Type=exec
DynamicUser=yes
User=hatch-memory-profiler
Group=hatch-memory-profiler
Slice=hatch-host.slice
UMask=0077
Sockets=com.hatch.memory-profiler.socket
CacheDirectory=hatch-memory-profiler
CacheDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
# PeerAcl resolves the authenticated producer through its host pidfd/cgroup.
ProtectProc=default
ProcSubset=all
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/etc/hatch/credentials -/etc/tls -/hatch -/var/lib/hatch -/var/lib/hatch-runtime
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
Environment=RUST_LOG=info
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
WorkingDirectory=/
ExecStart=${host_bin_dir}/hatch-memory-profiler
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hatch-memory-profiler
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
LimitNOFILE=256
LimitCORE=0:0
MemoryMax=64M
MemorySwapMax=0
CPUQuota=25%
TasksMax=16
Nice=19
IOSchedulingClass=idle
IOAccounting=true