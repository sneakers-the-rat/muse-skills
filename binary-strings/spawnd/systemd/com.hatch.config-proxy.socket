[Unit]
Description=com.hatch.config-proxy socket
ConditionPathExists=!${keep_services_down_early_marker}

[Socket]
ListenStream=/run/hatch/config-proxy/config.sock
DirectoryMode=0755
SocketUser=root
SocketGroup=root
# PeerAcl admits only the configured host services and privsep workers.
SocketMode=0666
RemoveOnStop=true
FlushPending=no

[Install]
WantedBy=sockets.target