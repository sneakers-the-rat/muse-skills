[Unit]
Description=com.hatch.rescue-systemctl worker (%i)

[Service]
Type=simple
User=root
Group=root
Slice=hatch-host.slice
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=-/run/systemd -/run/dbus -/etc/machine-id
# This isolated service cannot read /etc/hatch, so provide the baseline log
# level directly while leaving higher verbosity available through a drop-in.
Environment=RUST_LOG=info
Environment=PATH=${host_bin_dir}:${image_bin_dir}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardInput=socket
StandardOutput=socket
StandardError=journal
ExecStart=${host_bin_dir}/hatch-rescue-systemctl