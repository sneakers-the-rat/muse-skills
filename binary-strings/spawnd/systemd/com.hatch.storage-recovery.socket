[Unit]
Description=com.hatch.storage-recovery socket
# Mount-independent emergency control plane: this listener must exist even
# when the reliable-volume boot graph fails under ENOSPC. systemd creates its
# /run parent path instead of depending on host-path-setup or hatch-rv.target.
ConditionPathExists=!${keep_services_down_early_marker}
ConditionPathExists=${host_bin_dir}/hatch-storage-recovery

[Socket]
ListenStream=/run/hatch/storage-recovery/http-api.sock
FileDescriptorName=storage-recovery-http
Service=com.hatch.storage-recovery.service
SocketUser=root
SocketGroup=root
# PeerAcl is the authorization boundary; only ingress is admitted.
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=sockets.target