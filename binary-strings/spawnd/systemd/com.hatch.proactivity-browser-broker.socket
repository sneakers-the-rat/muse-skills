[Unit]
Description=Hatch proactivity browser broker socket
ConditionPathExists=!${keep_services_down_early_marker}
DefaultDependencies=no
PartOf=hatch-rv.target

[Socket]
ExecStartPre=+/usr/bin/install -d -m 0755 -o root -g root /run/hatch
# The privileged viewer mount must have no broker-writable ancestor.
ExecStartPre=+/usr/bin/install -d -m 0755 -o root -g root /run/hatch/proactivity-browser-broker
ListenStream=/run/hatch/proactivity-browser-broker/proactivity-browser-broker.sock
DirectoryMode=0755
SocketUser=hatch-browser-broker
SocketGroup=hatch-browser-broker
# The daemon's host connect supervisor is admitted by the same pidfd/cgroup
# PeerAcl as chat. This path is never bind-mounted into the runtime cell.
SocketMode=0666
FileDescriptorName=proactivity
Service=com.hatch.proactivity-browser-broker.service
RemoveOnStop=true

[Install]
WantedBy=hatch-rv.target