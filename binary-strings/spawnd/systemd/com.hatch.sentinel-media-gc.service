[Unit]
Description=Hatch Sentinel media copy garbage collection
ConditionPathExists=!${keep_services_down_early_marker}
RequiresMountsFor=${var_lib_dir}/sentinel/egress
PartOf=hatch-rv.target

[Service]
Type=oneshot
User=${sentinel_user}
Group=${sentinel_group}
Slice=hatch-runtime.slice
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-${var_lib_dir}/sentinel/egress
InaccessiblePaths=-/etc/hatch/credentials
Environment=JARVIS_HOME=${jarvis_home}
Environment=JARVIS_VAR_LIB_DIR=${var_lib_dir}
WorkingDirectory=/
ExecStart=${host_bin_dir}/hatch-sentinel --gc-media-artifacts
TimeoutStartSec=5min