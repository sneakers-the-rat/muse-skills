[Unit]
# RV-coupled socket must skip the implicit early sockets.target phase.
DefaultDependencies=no
Description=com.hatch.credit-watcher socket
ConditionPathExists=!${keep_services_down_early_marker}
After=com.hatch.host-path-setup.service
Requires=com.hatch.host-path-setup.service
PartOf=com.hatch.credit-watcher.service hatch-rv.target

[Socket]
ListenStream=/run/hatch/credit-watcher/credit-watcher.sock
DirectoryMode=0755
SocketUser=${credit_watcher_user}
SocketGroup=${shared_group}
SocketMode=0666
RemoveOnStop=true

[Install]
WantedBy=hatch-rv.target