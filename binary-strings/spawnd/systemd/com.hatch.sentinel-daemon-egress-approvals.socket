atch/private-upload-mask/opt/hatch/assets/run/hatch/cell-user-nssdbassets_bridgeuser_nssdb_cell_publication/run/hatch/cell-publication-emptycell_home_publication_deferredassets.pki/nssdb/home/hatchrv-graft: installed assets source is missingrv-graft: user NSS DB source is missingcell-home assembly returned an unexpected outcome countrv-graft: could not add installed assets to the cell-home publication treerv-graft: could not add the user NSS DB to the cell-home publication treerv-graft: runtime cell stopped during publication; the next pre-start will rebuild the bridgedeferred_to_cell_startruntime-cell did not receive the complete locked home publicationrv-graft: published the complete locked home tree to the running runtime cellpublished_to_running_cellrv-graft: cell-home publication completedrv-graft: runtime-cell home and read-only publications are already currentalready_currentopen / as the directory metadata rootdirectorytimeout--signal=KILLsystemctl-pActiveState--valueos_intent_ledger_ensureapt_archives_bridgeworker_state_bridge/var/lib/hatch/os-intentrv-graft: os-intent ledger bridge failed (best-effort; in-cell recorder appends land on the discardable pre-RV view)rv-graft: os-intent ledger ownership pre-create failed (best-effort; a root-created ledger silently stops the in-cell recorder)/var/lib/hatch/apt-archivesrv-graft: apt-archives cache bridge failed (best-effort; ledger replays fall back to network downloads)rv-graft: worker-state bridge failed (best-effort; the cell keeps its empty pre-RV view of this worker's state)open / as the cell-home propagation rootcell-home bridge fd path contains NULmake cell-home bridge a propagation slavemake cell-home bridge shared toward the runtime cellrv-graft: could not chown bridge sourcerv-graft: could not resolve bridge ownerrv-graft: retired legacy assets graftrv-graft: bridge mounted writable but contract is read-only; regrafting born-rorv-graft: bridge mounted (propagates into the running cell)rv-graft: bridge already mounted; leaving in placerv-graft: bridge refresh failed (stale tree keeps serving)resume_bridgecell_home_publicationrv-graft reconcile: resume bridge graft failed (best-effort)rv-graft reconcile: cell-home publication failed (best-effort)rv-graft reconcile: publication pass completedrv-graft reconcile: RV mount absent; boot graft owns publicationopen / as the refresh resolution rootrefresh sourcerefresh targetrv-graft: refreshed publication after source swaprv-graft: retired legacy whole-home bridgeprivate upload maskrv-graft: installed assets missing; leaving publication bridge emptyrv-graft: installed-assets pre-start publish failed; leaving bridge emptyrv-graft: installed-assets bridge refreshed born-read-onlyrv-graft: retired legacy user NSS DB graftmessenger-climemory-profiler-sockhatch-memory-profilerhatch-browser-lease-helperbrowser-lease-helper-sockwaiigd-clihatch-authdnoded-http-api-socktailscale-proxy-sockguest-runtime-env.sh#!/bin/sh

# guest-runtime-env.sh — shared runtime environment exports for runtime-cell
# entrypoints on both the host and guest side. Source this file; it only
# computes environment and does not exec.

runtime_cell_proxy_host=hatch-egress-proxy
no_proxy_hosts="localhost,127.0.0.1,::1,[::1],${runtime_cell_gateway_ip},${runtime_cell_address_ip},${runtime_cell_gateway_ipv6_ip},[${runtime_cell_gateway_ipv6_ip}],${runtime_cell_address_ipv6_ip},[${runtime_cell_address_ipv6_ip}]"

env_value_or_empty() {
    printenv "$1" 2>/dev/null || true
}

umask 0007

# control-daemon.sh applies the host env files before nsenter. Preserve this
# inherited value because the guest copy of ${env_file} contains the generated
# default and would otherwise erase a host-side socket override before the
# daemon starts.
inherited_sandbox_api_sock="$(env_value_or_empty JARVIS_SANDBOX_API_SOCK)"

if [ -r "${env_file}" ]; then
    . "${env_file}"
fi
if [ -r "${env_override_file}" ]; then
    . "${env_override_file}"
fi

if [ -n "$inherited_sandbox_api_sock" ]; then
    JARVIS_SANDBOX_API_SOCK="$inherited_sandbox_api_sock"
fi
if [ -n "${JARVIS_SANDBOX_API_SOCK:-}" ]; then
    export JARVIS_SANDBOX_API_SOCK
fi

export JARVIS_HOME="${jarvis_home}"
export JARVIS_BIN_DIR="${host_bin_dir}"
export JARVIS_AUTHD_SOCK="/run/hatch/auth/authd.sock"
export JARVIS_STEFI_PROXY_SOCK="/run/hatch/proxy/stefi.sock"
export HOME="${jarvis_home}"
export TMPDIR="/var/tmp"
export TMP="/var/tmp"
export TEMP="/var/tmp"
export XDG_CONFIG_HOME="${jarvis_home}/.config"
export XDG_CACHE_HOME="${jarvis_home}/.cache"
export XDG_STATE_HOME="${jarvis_home}/.local/state"
export HTTP_PROXY="http://$runtime_cell_proxy_host:3128"
export HTTPS_PROXY="http://$runtime_cell_proxy_host:3128"
export ALL_PROXY="http://$runtime_cell_proxy_host:3128"
export NO_PROXY="$no_proxy_hosts"
export http_proxy="http://$runtime_cell_proxy_host:3128"
export https_proxy="http://$runtime_cell_proxy_host:3128"
export all_proxy="http://$runtime_cell_proxy_host:3128"
export no_proxy="$NO_PROXY"
export SSL_CERT_FILE="/run/hatch/egress-tls/ca-bundle.pem"
export REQUESTS_CA_BUNDLE="/run/hatch/egress-tls/ca-bundle.pem"
export CURL_CA_BUNDLE="/run/hatch/egress-tls/ca-bundle.pem"
export WGETRC="${runtime_cell_dir}/etc/wgetrc"
export AWS_CA_BUNDLE="/run/hatch/egress-tls/ca-bundle.pem"
export NODE_EXTRA_CA_CERTS="/run/hatch/egress-tls/ca-bundle.pem"
# Parity with guest.env: make Node's built-in fetch honor the proxy env.
export NODE_USE_ENV_PROXY=1
export GIT_SSL_CAINFO="/run/hatch/egress-tls/ca-bundle.pem"
if [ -z "$PATH" ]; then
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
fi
export PATH="${host_bin_dir}:${image_bin_dir}:$PATH"
#!/bin/bash
set -euo pipefail

# host-path-setup.sh — create the shared, non-authd host runtime/state dirs
# that RV-scoped services need once the Hatch mounts are ready.
#
# Ordering: com.hatch.host-path-setup.service runs this oneshot AFTER the
# RV-backed mounts (home-hatch.mount, var-lib-hatch.mount), so it executes only
# once the RV is mounted. It must therefore ONLY create paths needed
# post-RV-mount. Do NOT add any path a mount-independent service needs BEFORE
# the RV is available — those services stay on multi-user.target and create
# their own dirs ahead of the RV. Paths that must NOT appear here:
#   - com.hatch.authd:   /run/hatch/auth
#   - com.hatch.vault:   /run/hatch/vault

warn() {
    printf 'warning: %s\n' "$*" >&2 || :
}

parallel_pids=()
parallel_labels=()
parallel_policies=()

register_parallel_job() {
    parallel_labels+=("$1")
    parallel_pids+=("$2")
    parallel_policies+=("${3:-required}")
}

run_in_parallel() {
    local label="$1"
    shift

    "$@" &
    register_parallel_job "$label" "$!"
}

wait_for_parallel_jobs() {
    local aggregate_status=0
    local index status

    # A bare `wait` returns zero after all active children and hides individual
    # failures. Reap every child and keep optional diagnostics from deciding
    # this boot gate's outcome, even when their process is killed.
    for index in "${!parallel_pids[@]}"; do
        if wait "${parallel_pids[$index]}"; then
            continue
        else
            status=$?
        fi

        if [ "${parallel_policies[$index]}" = optional ]; then
            warn "optional job '${parallel_labels[$index]}' failed with status $status; continuing with partial telemetry"
            continue
        fi

        warn "parallel job '${parallel_labels[$index]}' failed with status $status"
        if [ "$aggregate_status" -eq 0 ]; then
            aggregate_status="$status"
        fi
    done

    parallel_pids=()
    parallel_labels=()
    parallel_policies=()
    return "$aggregate_status"
}

# Child paths can race safely only after their trusted parent is established.
# /run/hatch/daemon-ctl: RT-3 root-owned daemon lifecycle handoff (one file
# per key; /run/hatch/daemon stays the daemon SOCKET dir only — it is owned
# by hatch-daemon, uid 131072, i.e. cell root, so nothing root later reads
# may live there). /run/hatch/worker-state is only the cheap root-owned parent;
# deferred worker prep creates the per-tool views beneath it.
#
# /run/hatch and /run/hatch/privsep are now primarily owned by the bundle's
# tmpfiles fragment (etc/tmpfiles.d/hatch-privsep-socket-dirs.conf, applied by
# com.hatch.privsep-socket-dirs.service before the privsep sockets bind at
# image boot). This idempotent re-creation is kept as the COMPATIBILITY source
# for pool guests booted from an image predating that fragment, and as the
# post-RV mode re-assert over the OS image's looser 0775 privsep row.
# Contraction condition: drop the two rows here only once fleet pool images
# all carry a bundle shipping the fragment (until then, an old-image wake has
# no other same-mode creator on the graft path).
/usr/bin/install -d -m 0755 -o root -g root \
    /run/hatch \
    /run/hatch/proxy \
    /run/hatch/privsep \
    /run/hatch/tunnel \
    /run/hatch/daemon-ctl \
    /run/hatch/worker-state
# Keep this postgres:postgres contract identical to the PostgreSQL unit's own
# ExecStartPre and hatch-dbctl prepare_socket_dir. The duplicate setup lets
# PostgreSQL start in parallel while protecting direct install-time reruns.
run_in_parallel "postgres runtime path" \
    /usr/bin/install -d -m 0755 -o postgres -g postgres /run/hatch/postgres
# A direct `spawnd install` reruns this script outside systemd while rv-graft
# remains active/exited. Reconcile a real sanitized lifecycle projection instead
# of revoking it between rv-graft's ready marker and the daemon's post-barrier
# read. A symlink, directory, or absent handoff gets no exception: restore the
# ordinary private root-owned parent, and rv-graft can publish a later valid
# projection.
daemon_lifecycle_identity="/run/hatch/runtime-cell/shellworks-daemon-lifecycle-identity.json"
(
    if [ -f "$daemon_lifecycle_identity" ] && [ ! -L "$daemon_lifecycle_identity" ]; then
        /usr/bin/chown root:${daemon_group} "$daemon_lifecycle_identity"
        /usr/bin/chmod 0440 "$daemon_lifecycle_identity"
        /usr/bin/chmod 0510 /run/hatch/runtime-cell
        /usr/bin/chown root:${daemon_group} /run/hatch/runtime-cell
    else
        /usr/bin/install -d -m 0750 -o root -g root /run/hatch/runtime-cell
    fi
) &
register_parallel_job "runtime-cell lifecycle path" "$!"
# The browser-broker socket unit binds under this directory. The in-cell daemon
# reaches that host path through its connect supervisor; the directory is not
# exposed to arbitrary cell processes. Keep only the cheap root creation on the
# chat startup path; browser-path-setup owns browser account validation and the
# broker-writable `lease/` leaf. The runtime root itself stays root-owned (here
# and in browser-path-setup) so the broker cannot swap entries under it.
run_in_parallel "browser-broker runtime paths" \
    /usr/bin/install -d -m 0755 -o root -g root /run/hatch/browser-broker
# execd's two socket units (com.hatch.execd.socket, com.hatch.execd-taint.socket)
# bind under this directory. It is deliberately HOST-ONLY: no nspawn bind source,
# and nothing creates it inside the runtime cell. The in-cell daemon reaches
# execd.sock through its connect supervisor, which redoes the connect in the host
# mount namespace; on failure the supervisor falls through to the child's own
# connect() so cell-local sockets keep working, which is why an execd path the
# cell can also name (the old /run/hatch/daemon, a cell-writable tmpfs dir) was a
# hijack surface during an execd restart window. Sentinel dials execd-taint.sock
# here too.
#
# This is the creator for the RV-coupled com.hatch.execd-taint.socket and the
# post-RV re-apply for com.hatch.execd.socket, which binds pre-RV at
# sockets.target and so creates the same dir with the same owner/mode in its own
# ExecStartPre (the com.hatch.daemon.socket pattern). Keep the two in lockstep.
#
# root:root 0755, NOT setgid hatch-shared like /run/hatch/daemon: the socket
# FILES are owned by systemd (SocketUser/SocketGroup/SocketMode in the units) and
# a root-owned parent is what keeps anything else from unlinking or replacing
# them. The o+x bit is load-bearing for both consumers — the daemon's supervisor
# has entered the cell user namespace so it carries a cell-mapped uid and no host
# group at all, and Sentinel runs as its own account. Same shape as
# /run/hatch/auth and /run/hatch/whatsapp-keyd; PeerAcl and the socket modes,
# not the dir group, are the access gates.
run_in_parallel "execd runtime path" \
    /usr/bin/install -d -m 0755 -o root -g root /run/hatch/exec
run_in_parallel "RTC runtime path" \
    /usr/bin/install -d -m 0755 -o root -g root /run/hatch/rtc
run_in_parallel "credit-watcher runtime path" \
    /usr/bin/install -d -m 0755 -o ${credit_watcher_user} -g ${shared_group} /run/hatch/credit-watcher
# /run/hatch/daemon is setgid hatch-shared so the daemon's ws.sock
# (and any other socket bound there) inherits hatch-shared as its
# group at bind. The daemon's WebsocketBind chmods ws.sock to 0660
# so only hatch-shared members (real nginx workers, healthd,
# sentinel, …) can dial; host login users like `thatch` are NOT in
# hatch-shared and the kernel rejects their connect() before the
# in-cell SO_PEERCRED gate is consulted. The cell daemon cannot
# `chgrp` to a host gid outside its PrivateUsers map, so the group
# must come from the dir's setgid bit. The daemon unit also pins
# this via ExecStartPre= so hot deploys don't have to wait for
# next boot.
run_in_parallel "daemon runtime path" \
    /usr/bin/install -d -m 2750 -o ${daemon_user} -g ${shared_group} /run/hatch/daemon
# Root-private home for daemon-lifecycle-env.sh, the one handoff file
# control-daemon.sh SOURCES as root. It cannot live in /run/hatch/daemon above:
# that directory is owned by ${daemon_user} (host uid 131072), which is exactly
# what the runtime cell's guest root maps to, and rename(2) is gated on
# DIRECTORY write permission rather than the file's own mode — so the cell can
# swap a root:root file there between root writing it and root sourcing it
# (T285455409). Same reasoning that moved execd's sockets to /run/hatch/exec.
#
# root:root 0700, NOT the 0755 shape /run/hatch/exec uses: nothing but root
# reads this, so there is no traversal requirement to keep o+x for. Three
# creators must agree (this script, com.hatch.daemon.socket's ExecStartPre=,
# and spawnd's live-apply preflight) because this oneshot is
# RemainAfterExit=yes and an in-place live-update never re-runs it.
run_in_parallel "daemon lifecycle env path" \
    /usr/bin/install -d -m 0700 -o root -g root /run/hatch/daemon-lifecycle
# Host-visible Space share RPC parent. The socket file is still owned by
# com.hatch.daemon.socket, but this directory is the narrow traversal gate for
# the fully isolated share privsep worker.
run_in_parallel "space-share runtime path" \
    /usr/bin/install -d -m 0750 -o root -g hatch-space-share /run/hatch/space-share
# Host-visible checkout-spend RPC parent. The socket file is still owned by
# com.hatch.daemon.socket, but this directory is the narrow traversal gate for
# payment privsep workers. The group is image-provisioned; stale images from
# the rollout window get a root-only fallback so install/boot keep working, but
# checkout-spend IPC remains inaccessible until the image supplies the group.
(
    if getent group hatch-checkout-spend >/dev/null 2>&1; then
        /usr/bin/install -d -m 0750 -o root -g hatch-checkout-spend /run/hatch/checkout-spend
    else
        warn "hatch-checkout-spend group unavailable; checkout-spend IPC disabled until image rollout"
        /usr/bin/install -d -m 0700 -o root -g root /run/hatch/checkout-spend
    fi
) &
register_parallel_job "checkout-spend runtime path" "$!"
wait_for_parallel_jobs
# The metric boundary covers the paths above. Keep every diagnostic probe and
# write in a separate, bounded process: neither a full RV nor a stuck recorder
# may fail this required boot gate. The recorder publishes only under /run.
# Its own shell retains errexit without weakening the required setup jobs.
/usr/bin/timeout --kill-after=1s 5s \
    /opt/hatch/bin/record-daemon-lifecycle-boundaries.sh --host-path-setup &
register_parallel_job "boot timing publication" "$!" optional

(
/usr/bin/install -d -m 0750 -o ${safety_user} -g ${daemon_group} /run/hatch/safety
# Verification-code scanner parent, deliberately NOT /run/hatch/safety above.
# That directory is gated on hatch-daemon, which is right for ws.sock and
# security.sock (ingress and daemon) and wrong for this listener: its callers
# are privsep connector workers running as minimal hatch-w-<tool> identities
# that are not in hatch-daemon and must not be added to it. hatch-proxy-clients
# is the group every privsep worker already carries, so it is the traversal
# gate here; VERIFICATION_CODE_PEER_ACL stays the accept-time authority that
# narrows back down to the four reviewed callers.
/usr/bin/install -d -m 0750 -o ${safety_user} -g ${proxy_clients_group} /run/hatch/safety-scan
/usr/bin/install -d -m 0755 -o ${sentinel_user} -g ${sentinel_group} /run/hatch/sentinel
/usr/bin/install -d -m 0755 -o ${sentinel_user} -g ${sentinel_group} /run/hatch/egress-tls
# Cell trust-store publish dirs. build-cell-trust-store.sh (root, host) builds
# the cell's CA bundle and NSS databases entirely host-side and publishes them
# here; htch-runtime.nspawn binds each read-only over the matching cell path
# (/etc/ssl/certs, /etc/pki/nssdb, ${jarvis_home}/.pki/nssdb). nspawn fails the
# container start if a bind source is missing, so these must exist before the
# cell starts even though the producer that fills them runs later — the cell's
# own ExecStartPre seeds them best-effort so they are never empty in practice.
# Root-owned; 0755 for cross-userns read (neither owner nor group matches across
# the PrivateUsers map, so the other bits are what grant the cell access).
#
# There is deliberately no /run/hatch/ingress-tls here any more: that directory
# existed only to hand the extracted ingress CA to the in-cell certutil, and the
# host-side producer reads /etc/tls/credentials directly.
/usr/bin/install -d -m 0755 -o root -g root \
    /run/hatch/browser-broker-liveness \
    /run/hatch/cell-anchors \
    /run/hatch/cell-nssdb \
    /run/hatch/cell-user-nssdb
# Root owns the observation directory. Provision files without replacing their
# inode, so reapplying paths cannot hide an existing broker's flock from the
# read-only runtime-cell bind. This runs before RV-scoped broker activation.
for liveness_name in cron-browser-broker proactivity-browser-broker; do
    liveness_file="/run/hatch/browser-broker-liveness/$liveness_name.process-lock"
    if [ -L "$liveness_file" ]; then
        echo "host-path-setup: refusing symlinked process lock" >&2
        exit 1
    fi
    if [ ! -e "$liveness_file" ]; then
        (umask 0022; set -o noclobber; : > "$liveness_file")
    fi
    /usr/bin/chown hatch-browser-broker:hatch-browser-broker "$liveness_file"
    /usr/bin/chmod 0644 "$liveness_file"
done
/usr/bin/install -d -m 0750 -o ${rescue_user} -g ${daemon_group} /run/hatch/rescue
/usr/bin/install -d -m 0750 -o ${wai_user} -g ${wai_group} \
    /run/hatch/wai \
    /run/hatch/whatsapp-companion
# Keep the Messenger control directory independent of messengerd's lifecycle:
# the privsep worker's mount namespace needs this source path even while the
# daemon is stopped. The setgid bit makes the daemon-created socket inherit the
# dedicated client group; messengerd owns the socket mode.
/usr/bin/install -d -m 2710 -o ${messenger_user} -g ${messenger_client_group} \
    /run/hatch/messenger
# IGD control directory, same contract: independent of igdd's lifecycle, and
# setgid so the group-less hatch-igd daemon's socket inherits the image-owned
# hatch-igd-clients gate the IGD privsep worker joins. Both identities are
# image-owned and required (hatch-image D124782069, below the lock floor).
/usr/bin/install -d -m 2710 -o hatch-igd -g hatch-igd-clients /run/hatch/igd
# igdd's consumer ingress, kept out of the setgid control dir: the Jarvis
# daemon's supervisor has a remapped uid and no host groups, so it cannot
# traverse /run/hatch/igd. igd-cli's pidfd/cgroup PeerAcl admits only that
# daemon, and igdd exits at startup if it cannot bind here.
/usr/bin/install -d -m 0755 -o ${igd_user} -g ${igd_user} ${igd_ingress_dir}
# The daemon's host-side supervisor must traverse this dir to connect to
# keyd.sock. That process has entered the cell user namespace, so it holds no
# host group membership (the same reason keyd.sock is 0666); this mirrors
# authd's 0755 socket-dir pattern. keyd's PeerAcl (cgroup) is the real access
# gate, and keyd receives the socket via socket activation so the dir's setgid
# bit would be non-functional here.
/usr/bin/install -d -m 0755 -o ${whatsapp_keyd_user} -g ${whatsapp_keyd_group} /run/hatch/whatsapp-keyd
# cron-store persists the one-way host authority marker and native pristine
# bootstrap state. Keep both its UDS parent and filesystem records host-owned
# and absent from every cell bind. A dedicated account requires a fixed
# uid/gid provisioned by hatch-image first; spawnd must not create one
# dynamically during install.
/usr/bin/install -d -m 0755 -o root -g root /run/hatch/cron-store
# The matching /var/lib/hatch state dirs sit under the hatch-daemon-owned
# parent, so they are stamped fd-anchored via `spawnd fsop` (never path-resolving
# `install -d`), batched into ONE process. Per-entry openat2 RESOLVE_BENEATH
# fencing is unchanged; only the fork is shared. Per-dir rationale inline:
#   - keyd's pairing/state store stays group-private (2750): only keyd reaches
#     it; the daemon must never read pairing state.
#   - cron-definitions stays root-only (0700).
#   - Messenger is an eager hatch-rv.target service whose WorkingDirectory and
#     non-optional ReadWritePaths source must exist before deferred worker prep.
/opt/hatch/bin/spawnd fsop ensure-dirs --root /var/lib <<'SPECS'
2750 ${whatsapp_keyd_user}:${whatsapp_keyd_group} hatch/whatsapp-keyd
0700 root:root hatch/cron-definitions
0750 ${messenger_user}:${messenger_group} hatch/messenger
SPECS
# IGD's private state follows the existing fd-anchored setup contract; never
# reassign an existing foreign directory.
if /usr/bin/mountpoint -q /var/lib/hatch; then
    /opt/hatch/bin/spawnd fsop ensure-owned-dirs --root /var/lib <<'IGD_SPECS'
0700 60930:60930 hatch/igd
IGD_SPECS
fi
) &
register_parallel_job "remaining runtime and state paths" "$!"

# ${jarvis_home}/user and ${jarvis_home}/data: daemon-owned roots the cell writes
# into; ${jarvis_home}/data is the shared parent for connector-owned subdirs. Both
# re-applied every boot to repair homes an older install left root-owned.
#
# NEVER stamp these with `install -d`: it follows symlinks, and ${jarvis_home} is
# the read-write cell bind owned by ${daemon_user} -- which IS cell-root (host uid
# 131072). The cell can replace either name with a link and aim this root-run
# unit's chown+chmod anywhere; at /etc/ssh/sshd_config.d that is host root, since
# sshd parses its config as root and StrictModes does not cover it. Same reasoning
# as the no-follow `chown -h` on the Messenger directory below. This is easy to
# "simplify" back, so keep the general rule: a path-based privileged op cannot
# be made safe by checking the path first -- check and act resolve the name twice
# and the cell owns the gap. Operate on a descriptor instead.
#
# Loop vars are bare $name, never braced: render_template literal-replaces every
# registered template placeholder, then rejects any unresolved placeholder.
(
for hatch_home_rel in user data; do
    hatch_home_dst="${jarvis_home}/$hatch_home_rel"
    # A symlink, or anything not a directory, is never legitimate here.
    if [ -L "$hatch_home_dst" ] || { [ -e "$hatch_home_dst" ] && [ ! -d "$hatch_home_dst" ]; }; then
        echo "host-path-setup: replacing non-directory at $hatch_home_dst" >&2
        rm -f "$hatch_home_dst"
    fi
    # -m sets the mode via the fchmod mkdir issues on the fd it already holds. No
    # standalone chmod: chmod(2) is path-based with no NOFOLLOW, so a link planted
    # after the check would redirect it. Accepted trade-off -- -m applies only to a
    # directory mkdir creates, so an existing one keeps its mode; the cell owns
    # these and can set their mode anyway, so root re-stamping it never protected.
    mkdir -m 2770 -p "$hatch_home_dst"
    # -h: a symlink racing in is chowned itself, never followed.
    chown -h ${daemon_user}:${shared_group} "$hatch_home_dst"
done
unset hatch_home_rel hatch_home_dst
) &
register_parallel_job "Hatch home paths" "$!"

(
# Every private state dir here sits under the hatch-daemon-owned /var/lib/hatch,
# whose group-writable parent means a path-based root `install -d` would
# re-resolve the path and follow a symlink the cell planted into a root chown of
# an arbitrary host dir (2026-08 red-team, boot-walk finding). Each is therefore
# stamped fd-anchored via `spawnd fsop`, and they are batched into ONE process:
# per-entry openat2 RESOLVE_BENEATH|RESOLVE_NO_SYMLINKS fencing is unchanged;
# only the fork is shared. Parents precede children (rescue before its children,
# sentinel before sentinel/egress, telemetry-buglog before its snapshots). Per-dir
# rationale is inline; comment and blank lines in the spec are ignored.
/opt/hatch/bin/spawnd fsop ensure-dirs --root /var/lib <<'SPECS'
# Keep rescue's boot-time reconciliation identical to ensure_diagnostic_directory:
# the rescue identity may write only the pre-provisioned children, never replace
# entries directly beneath the root-owned anchor. The anchor is root-owned; its
# children carry the rescue identity; state-recovery keeps setgid daemon-group.
# Ordered anchor-first so the batch creates it before the children beneath it.
0750 root:${rescue_group} hatch/rescue
0750 ${rescue_user}:${rescue_group} hatch/rescue/reports
0750 ${rescue_user}:${rescue_group} hatch/rescue/vm-diagnostic
0750 ${rescue_user}:${rescue_group} hatch/rescue/daemon-stall-snapshots
0750 ${rescue_user}:${rescue_group} hatch/rescue/systemd-unit-profiles
0750 ${rescue_user}:${rescue_group} hatch/rescue/home-usage
2750 ${rescue_user}:${daemon_group} hatch/rescue/state-recovery
0755 root:root hatch/db-preflight
# Durable browser-broker state, including the bounded exact-origin ambient-state
# cache. Broker-owned and private; on RV-backed /var/lib/hatch so semantic
# browser state survives an ephemeral re-image.
0700 hatch-browser-broker:hatch-browser-broker hatch/browser-broker
0710 ${safety_user}:${shared_group} hatch/safety
0750 ${sentinel_user}:${sentinel_group} hatch/sentinel
0750 ${sentinel_user}:${sentinel_group} hatch/sentinel/egress
# WAI and Companion state share the same fd-anchored creation contract.
0750 ${wai_user}:${wai_group} hatch/wai
0750 ${wai_user}:${wai_group} hatch/whatsapp-companion
# rv-graft's one-time decoy-removal stamp dir (RT-21): root-only, ensured here
# as belt — the graft's own fd-anchored mkdir_p is the load-bearing creation,
# and a group-writable parent means the dir itself must never be trusted by
# pathname.
0700 root:root hatch/rv-graft
# Private durable ring buffer and immutable bug-report snapshots.
0700 ${telemetry_proxy_user}:${telemetry_proxy_user} hatch/telemetry-buglog
0700 ${telemetry_proxy_user}:${telemetry_proxy_user} hatch/telemetry-buglog/snapshots
SPECS
# Kill-switch directory (RT-9): HOST-LOCAL /var/lib/hatch-dev-controls,
# root:root 0700. The retired RV twin (${var_lib_dir}/dev-controls) lived
# under /var/lib/hatch, whose PARENT is owned by hatch-daemon — uid 131072,
# the runtime cell's root — so cell-root-equivalent code could rename the
# dev-controls dir aside, recreate it, and mint keep-services-down: a
# durable, unprivileged fleet brake. The host-local dir sits on the root
# filesystem with a root-owned parent chain; only real host root writes it.
# Every unit's ConditionPathExists now names ONLY the host-local marker
# (${keep_services_down_early_marker}); dev-controls-reconcile.sh enforces
# it against already-running units.
/usr/bin/install -d -m 0700 -o root -g root /var/lib/hatch-dev-controls
# Cutover belt: carry a PRE-cutover OPERATOR brake across the marker move,
# EXACTLY ONCE. Without this, a VM deliberately held down with the retired RV
# marker comes back up silently on its first post-cutover install or boot.
# This is a ONE-SHOT CONSUMPTION, not a standing reader (paths.rs forbids new
# readers of the retired spelling): a qualifying legacy marker is translated
# into the host-local marker and then UNLINKED, so the retired path holds
# brake authority for exactly one migration and never again — and on CVMs the
# translated marker is per-boot like every host-local brake, by design.
#
# Fail-closed against the component the cell owns. The legacy parent dir is
# cell-root-replaceable, so the read is descriptor-relative and non-blocking:
# the parent opens O_NOFOLLOW|O_DIRECTORY (a swapped symlink is refused; a
# swapped real dir only yields cell-owned files the uid gate refuses), the
# marker opens via dir_fd with O_NOFOLLOW|O_NONBLOCK (planted symlink ->
# ELOOP; planted FIFO -> opens instantly instead of wedging the boot oneshot
# — the hatch-preflight-opportunistic house pattern), and only a REGULAR file
# owned by host uid 0 on the held fd qualifies: operators minted the legacy
# marker via `sudo touch`, while cell-root writes as uid 131072 and cannot
# chown to host root. The remaining forgery path — hardlinking a root-owned
# RV file to the marker name — is closed by fs.protected_hardlinks, a distro
# default this block PINS below because the ownership gate leans on it. The
# outer `timeout` is belt: no syscall in the block can block, and a nonzero
# exit only warns.
sysctl -qw fs.protected_hardlinks=1 ||
    warn "failed to pin fs.protected_hardlinks=1 (distro default should hold)"
# Fast path: the legacy dev-controls dir exists only on pre-cutover hosts, and
# on the volatile-/etc fleet it is absent every boot. Skip the ~30ms python
# interpreter startup unless there is actually something to migrate. This gate
# is a performance fast-path ONLY — when the dir is present the python below
# still does the full TOCTOU-safe check (O_NOFOLLOW/O_DIRECTORY, uid-0 gate),
# so a cell-planted symlink that fools `[ -d ]` just forks a python that then
# refuses it. `[ -d ]` false (absent, dangling, or non-dir) is exactly the case
# the python would sys.exit(0) on, so nothing is skipped that would migrate.
if [ -d "${var_lib_dir}/dev-controls" ]; then
timeout 5 python3 - <<'PYEOF' || warn "legacy keep-services-down migration check failed"
import os, stat, sys
legacy_dir = "${var_lib_dir}/dev-controls"
legacy_name = "keep-services-down"
new = "${keep_services_down_early_marker}"
try:
    dfd = os.open(legacy_dir, os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY)
except OSError:
    sys.exit(0)
try:
    try:
        fd = os.open(
            legacy_name,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
            dir_fd=dfd,
        )
    except OSError:
        sys.exit(0)
    try:
        st = os.fstat(fd)
        if st.st_uid != 0 or not stat.S_ISREG(st.st_mode):
            sys.exit(0)
        if not os.path.lexists(new):
            with open(new, "w"):
                pass
        # Consume the legacy marker in the same pass: intent is carried, and
        # the retired spelling must not keep standing brake authority.
        os.unlink(legacy_name, dir_fd=dfd)
        print(
            "host-path-setup: migrated pre-cutover operator brake "
            f"{legacy_dir}/{legacy_name} -> {new} (legacy file consumed; "
            "on CVMs re-touch the host-local marker after a reboot)",
            file=sys.stderr,
        )
    finally:
        os.close(fd)
finally:
    os.close(dfd)
PYEOF
fi

) &
register_parallel_job "durable service paths" "$!"

# Runtime-cell rootfs parent on reliable-volume hosts. On an RV host the
# runtime-cell rootfs parent resolves to /hatch/runtime-cell, and the
# runtime-cell unit lists it in ReadWritePaths=. systemd validates that path
# before the unit's ExecStartPre= (ensure-rootfs.sh) runs, so on a freshly
# formatted RV the directory must already exist or namespace setup fails.
# Create it here once /hatch is a real mount; non-RV hosts use
# /var/lib/hatch-runtime instead and never reach this branch.
(
if mountpoint -q /hatch; then
    /usr/bin/install -d -m 0755 -o root -g root /hatch/runtime-cell
fi
) &
register_parallel_job "runtime-cell rootfs path" "$!"

# Surface the bundle-shipped nspawn + network configs into systemd's fixed config
# search paths via symlinks. systemd-nspawn (--machine, searches
# /etc/systemd/nspawn) and systemd-networkd (/etc/systemd/network) can't be
# pointed at /opt/hatch, so we link rather than copy: the link path is stable and
# the bundle refreshes the /opt/hatch target on every install. The runtime and
# browser cells Require=+After= this unit through their setup oneshots, so the
# links are in place before they start. Tolerant of bundles/images that don't
# ship these into /opt/hatch yet.
(
for rel in \
    etc/systemd/nspawn/htch-runtime.nspawn \
    etc/systemd/network/10-ve-htch-runtime.network \
    etc/systemd/nspawn/htch-browser.nspawn \
    etc/systemd/network/10-ve-htch-browser.network; do
    src="/opt/hatch/$rel"
    dst="/$rel"
    if [ -e "$src" ]; then
        /usr/bin/install -d -m 0755 -o root -g root "$(dirname "$dst")"
        ln -sfn "$src" "$dst"
    fi
done
) &
register_parallel_job "systemd cell configuration links" "$!"

wait_for_parallel_jobs
dev-controls-reconcile.sh#!/bin/bash
set -euo pipefail

# dev-controls-reconcile.sh — enforce the keep-services-down brake against
# units that are already running when the brake is set.
#
# RT-9: the brake marker is HOST-LOCAL ONLY now
# (${keep_services_down_early_marker}, under root:root 0700
# /var/lib/hatch-dev-controls). The retired RV marker
# (/var/lib/hatch/dev-controls/keep-services-down) sat under a parent owned
# by hatch-daemon — uid 131072, the runtime cell's ROOT — so
# cell-root-equivalent code could rename dev-controls aside, recreate it, and
# mint a durable fleet brake without host root. Every unit's
# ConditionPathExists=! names only the host-local marker, which also removes
# the old pre-RV/post-RV twin split: the marker either exists this boot or it
# does not, identically at every start.
#
# A pre-cutover RV brake does not vanish silently: host-path-setup's
# one-shot migration translates a host-root-owned legacy marker into the
# host-local marker (and consumes the legacy file) before this reconcile
# ever runs.
# Operators: `sudo touch ${keep_services_down_early_marker}` to brake,
# `sudo rm` it to release. The root overlay upper is re-keyed and reformatted
# every boot on every hatchling, so the brake is PER-BOOT by design — a
# durable brake writable below host root was the vulnerability.
#
# ConditionPathExists only gates STARTS, so this reconcile (triggered at
# volume attach, deliberately carrying no brake condition itself):
#   brake set   -> stop the early units that started before the marker
#                  appeared, and stamp /run so release knows to restart;
#   brake clear -> if this boot had applied the brake, start the early units
#                  whose condition-skipped starts left them down.
#
# --no-block keeps enforcement out of the RV start transaction (it converges
# within this boot; it is not ordering). The list is explicit — never glob
# com.hatch.*: ingress-rev-proxy, vault, and their tee-report helper deliberately
# carry no kill-switch gate (remote reachability). A running Sentinel is not
# swept directly: preserve the egress governor through the ordered runtime
# drain. Its own brake condition now blocks new starts, including restarts
# after failure, so an RV migration cannot revive this writer (RT-10 change).
# This reconcile unit itself must never appear in the sweep.

warn() {
    printf 'warning: %s\n' "$*" >&2
}

brake_applied_stamp="/run/hatch/dev-controls-brake-applied"
runtime_cell_drain_file=${runtime_cell_drain_file}

early_units=(
    com.hatch.runtime-cell.service
    com.hatch.daemon.service
    com.hatch.daemon.socket
    com.hatch.voice-speak.socket
    com.hatch.meta-ai-search.socket
    com.hatch.execd.socket
    com.hatch.authd.service
    com.hatch.authd.socket
    com.hatch.browser-broker.socket
    com.hatch.cron-browser-broker.socket
    com.hatch.proactivity-browser-broker.socket
    com.hatch.spaces-browser-broker.socket
    com.hatch.research-browser-broker.socket
    com.hatch.armor.service
    com.hatch.healthd.service
    com.hatch.journal-proxy.service
    com.hatch.runtime-cell-modules.service
    com.hatch.www-proxy.service
    com.hatch.www-proxy.socket
    com.hatch.gk-proxy.service
    com.hatch.gk-proxy.socket
    com.hatch.memory-profiler.socket
    com.hatch.stefi-proxy.service
    com.hatch.stefi-proxy.socket
    com.hatch.telemetry-proxy.service
    com.hatch.telemetry-proxy.socket
    com.hatch.rescue-systemctl.socket
    com.hatch.storage-recovery.socket
    com.hatch.storage-recovery-filesystem.socket
    com.hatch.noded.service
    com.hatch.noded-control.socket
    com.hatch.noded-ephemeral.socket
    com.hatch.noded-http-api.socket
    # The remote PostgreSQL pre-dial units start before the RV mounts, so the
    # brake must sweep them like every other early unit. The relay's path unit
    # MUST be stopped together with its socket: it is level-triggered
    # (PathExists=) and survives the RV teardown by design, so left active
    # under a brake it would retrigger the condition-skipped socket in a busy
    # loop until the path unit fails. On release, starting the socket is a
    # condition-gated no-op on local-PostgreSQL boots.
    com.hatch.postgres-mode.path
    com.hatch.postgres-remote.path
    com.hatch.postgres-remote.socket
    com.hatch.postgres-remote.service
    # The generated privsep tool sockets bind at image boot (dual-wanted on
    # sockets.target + hatch-rv.target), so a brake set on a running host
    # must sweep them like every other early listener; their brake condition
    # only gates the NEXT start. The membership is rendered from the privsep
    # registry — not hand-listed, not a glob — so a new tool cannot silently
    # escape the kill switch. Sockets only: the @.service instances are
    # per-connection (Accept=yes) and exit on their own, and their next
    # activation is gated by the stopped listener plus the unit's own brake
    # condition. On brake clear the start below rebinds the listeners; their
    # Wants= re-pulls the dirs oneshot, and a listener whose bind-time state
    # is stale is rebuilt by the normal graft-time pull.
    ${privsep_socket_units}
)
if [ -e "${keep_services_down_early_marker}" ]; then
    install -d -m 0755 -o root -g root "$(dirname "$brake_applied_stamp")"
    touch "$brake_applied_stamp"
    # Also sweep the units the boot-pulled set activates transitively
    # (execd and storage recovery via their sockets, the trust-store builders
    # via the cell). Keep lazy services out of the restart list above.
    # Sentinel is not swept directly; its runtime-cell stop coupling remains.
    systemctl stop --no-block "${early_units[@]}" \
        com.hatch.execd.service \
        com.hatch.memory-profiler.service \
        com.hatch.storage-recovery.service \
        com.hatch.storage-recovery-filesystem.service \
        com.hatch.runtime-cell-trust-store.service \
        com.hatch.runtime-cell-trust-store-egress.path ||
        warn "kill-switch: stopping early units failed"
    # The runtime-cell stop hook also suppresses this fence when the brake is
    # present. Clear any older marker after enqueueing the stop so recovery
    # access is not held behind a deliberate keep-down operation.
    rm -f "$runtime_cell_drain_file"
elif [ -e "$brake_applied_stamp" ]; then
    rm -f "$brake_applied_stamp"
    systemctl start --no-block "${early_units[@]}" ||
        warn "kill-switch: restarting early units failed"
fi
browser-path-setup.sh#!/bin/bash
set -euo pipefail

# browser-path-setup.sh — create browser-broker bind sources.
#
# Browser paths are not prerequisites for chat/socket readiness. Keep them in a
# dedicated unit so replacement VM startup can bring up the daemon without
# waiting on browser account/path setup.

/usr/bin/install -d -m 0755 -o root -g root /run/hatch

if ! getent passwd hatch-browser-broker >/dev/null 2>&1; then
    echo "browser-path-setup: required hatch-browser-broker user is missing" >&2
    exit 1
fi
if ! getent group hatch-browser-broker >/dev/null 2>&1; then
    echo "browser-path-setup: required hatch-browser-broker group is missing" >&2
    exit 1
fi

# Cron setup has its own service transaction. Never let a Cron leaf failure
# abort Chat/local-cell setup, or let a Cron start touch Chat's existing paths.
case "${1:-user}" in
    cron)
        /usr/bin/install -d -m 0755 -o root -g root /run/hatch/cron-browser-broker
        /usr/bin/install -d -m 0700 -o hatch-browser-broker -g hatch-browser-broker /run/hatch/cron-browser-broker/lease
        /usr/bin/install -d -m 2750 -o root -g ${shared_group} /run/hatch/cron-browser-broker/viewer
        /opt/hatch/bin/spawnd fsop ensure-dir --root /var/lib --path hatch/cron-browser-broker --mode 0700 --owner hatch-browser-broker:hatch-browser-broker
        exit 0
        ;;
    proactivity)
        /usr/bin/install -d -m 0755 -o root -g root /run/hatch/proactivity-browser-broker
        /usr/bin/install -d -m 0700 -o hatch-browser-broker -g hatch-browser-broker /run/hatch/proactivity-browser-broker/lease
        /usr/bin/install -d -m 2750 -o root -g ${shared_group} /run/hatch/proactivity-browser-broker/viewer
        /opt/hatch/bin/spawnd fsop ensure-dir --root /var/lib --path hatch/proactivity-browser-broker --mode 0700 --owner hatch-browser-broker:hatch-browser-broker
        exit 0
        ;;
    spaces)
        /usr/bin/install -d -m 0755 -o root -g root /run/hatch/spaces-browser-broker
        /usr/bin/install -d -m 0700 -o hatch-browser-broker -g hatch-browser-broker /run/hatch/spaces-browser-broker/lease
        /usr/bin/install -d -m 2750 -o root -g ${shared_group} /run/hatch/spaces-browser-broker/viewer
        /opt/hatch/bin/spawnd fsop ensure-dir --root /var/lib --path hatch/spaces-browser-broker --mode 0700 --owner hatch-browser-broker:hatch-browser-broker
        exit 0
        ;;
    user) ;;
    *) echo "browser-path-setup: expected user, cron, proactivity or spaces" >&2; exit 1 ;;
esac

# Every path below a browser-writable parent is opened relative to a held root
# descriptor. Existing entries must already have the requested owner; a planted
# symlink or swapped-in host directory fails the unit before any chmod/chown.
/opt/hatch/bin/spawnd fsop ensure-owned-dirs --root /run <<'SPECS'
0755 root:root hatch/browser-broker
0700 hatch-browser-broker:hatch-browser-broker hatch/browser-broker/lease
2750 root:${shared_group} hatch/browser-broker/viewer
2755 ${browser_cell_hbi_hatch_host_uid}:${browser_cell_hbi_broker_host_gid} hatch/browser
2750 ${browser_cell_hbi_hatch_host_uid}:${browser_cell_hbi_shared_host_gid} hatch/browser/viewer
0755 root:root hatch/browser-cell
2710 ${browser_cell_private_users_base}:${browser_cell_hbi_broker_host_gid} hatch/browser-cell/central-blackhole
0755 root:root hatch/browser-cell/egress-policy
SPECS

# The lease helper writes and removes the browser cell's test-VM egress lock
# drop-in here; its sandbox can write only directories that exist when it starts.
/usr/bin/install -d -m 0755 -o root -g root /run/systemd/system/com.hatch.browser-container.service.d

# nspawn creates an empty work directory beside each overlay source
# (.#egress-policy plus 16 hex digits) and removes it only when it exits
# cleanly, so a killed cell leaves one per policy overlay. This also runs under
# a running cell, before every broker start: a read-only overlay mounts with
# lowerdir= alone, so a live cell never uses its work directory, and nspawn
# ignores a missing one at exit. Only host root writes this directory, and
# rmdir removes nothing but an empty directory.
for stale in /run/hatch/browser-cell/.#egress-policy*; do
    rmdir -- "$stale" 2>/dev/null || true
done

/opt/hatch/bin/spawnd fsop ensure-owned-dirs --root ${var_lib_dir} <<'SPECS'
0755 root:root central-blackhole
0755 root:root central-blackhole/filter
2770 ${browser_cell_hbi_hatch_host_uid}:${browser_cell_hbi_broker_host_gid} browser
2770 ${browser_cell_hbi_hatch_host_uid}:${browser_cell_hbi_broker_host_gid} browser/cache
2770 ${browser_cell_hbi_hatch_host_uid}:${browser_cell_hbi_broker_host_gid} browser/profile
0700 ${browser_cell_hbi_hatch_host_uid}:${browser_cell_hbi_broker_host_gid} browser/uploads
0755 root:root browser-work
2770 ${browser_cell_hbi_hatch_host_uid}:${browser_cell_hbi_broker_host_gid} browser-work/profile
0700 ${browser_cell_hbi_hatch_host_uid}:${browser_cell_hbi_broker_host_gid} browser-work/uploads
0700 ${browser_cell_hbi_hatch_host_uid}:${browser_cell_hbi_broker_host_gid} browser-work/pki
SPECS

# Publish the browser cell's static hostname mapping from the host. The nspawn
# config binds this file read-only over /etc/hosts, so no host-credentialed
# process ever executes a binary from the cell-owned rootfs to update it.
cat <<'HOSTS' | /opt/hatch/bin/spawnd fsop write --root /run/hatch/browser-cell --path hosts --mode 0644
127.0.0.1 localhost
::1 localhost ip6-localhost ip6-loopback
127.0.1.1 ${browser_cell_machine}
::1 ${browser_cell_machine}
HOSTS
hatch-runtime-setup#!/bin/bash
set -euo pipefail

# systemd finds units + .wants/ in /opt/hatch/etc/systemd/ via
# SYSTEMD_UNIT_PATH. daemon-reload makes it rescan for changes.
systemctl daemon-reload
record-daemon-lifecycle-boundaries.sh#!/bin/sh
set -eu

# This runs as host root. Every artifact it persists goes through
# publish_file below (O_EXCL|O_NOFOLLOW creation of a random-named stage file
# plus rename; modes from the umask, never a path-based chmod). All output is
# boot-scoped under /run, so an exhausted RV cannot prevent diagnostics. The
# legacy hatch-image timing record on the RV is an optional, bounded input.
# The handoff dir itself is RT-3
# root-owned /run/hatch/daemon-ctl — hatch-daemon-owned /run/hatch/daemon
# (cell-root-forgeable) must never carry lifecycle handoff state again — and
# keeps the same publish discipline as belt.
umask 022

case "$#:${1:-}" in
    0:) host_path_setup=false ;;
    1:--host-path-setup)
        host_path_setup=true
        post_host_path_setup_ready_at_ms="$(date +%s%3N)"
        ;;
    *) printf 'usage: %s [--host-path-setup]\n' "$0" >&2; exit 64 ;;
esac

handoff_dir="/run/hatch/daemon-ctl"
output="$handoff_dir/post-hatch-mount-boundaries.json"
current_output="$handoff_dir/post-hatch-mount-boundaries.current.json"
var_lib_dir="${var_lib_dir}"
boot_timings_dir="$var_lib_dir/boot-timings"
boot_id="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || printf 'unknown')"
guest_hatch_mount_boundaries="$boot_timings_dir/hatch-mount-boundaries.$boot_id.json"

# Root ownership on the handoff dir is the RT-3 point, but only assert it
# when we CAN (real boots run this as root via the unit; host-path-setup and
# pre-start already own the prod dir). The test harness runs this script as
# an ordinary user against a sandboxed handoff dir, where `install -o root`
# is EPERM and `set -eu` would abort the suite before the boundary tests run.
if [ "$(id -u)" = 0 ]; then
    install -d -m 0755 -o root -g root "$handoff_dir"
else
    install -d -m 0755 "$handoff_dir"
fi

warn() {
    printf 'warning: %s\n' "$*" >&2
}

# stdin -> $1, atomically, never following a symlink at any written pathname.
publish_file() {
    publish_dest="$1"
    publish_tmp="$(mktemp -u "${publish_dest%/*}/.boundaries-stage.XXXXXXXX")"
    # Every caller pipes into this function, so these traps are confined to the
    # publisher subprocess. Reap a partial stage when the recorder times out.
    trap 'rm -f "$publish_tmp"' 0
    trap 'exit 1' HUP INT TERM
    if ! dd of="$publish_tmp" conv=excl oflag=nofollow status=none 2>/dev/null; then
        rm -f "$publish_tmp"
        warn "failed to stage $publish_dest"
        return 1
    fi
    mv -f "$publish_tmp" "$publish_dest"
}

timestamp_file_ms_or_null() {
    path="$1"
    if [ -r "$path" ]; then
        value="$(tr -d '[:space:]' < "$path")"
        case "$value" in
            ''|*[!0-9]*)
                ;;
            *)
                printf '%s' "$value"
                return
                ;;
        esac
    fi
    printf 'null'
}

unit_timestamp_ms_or_null() {
    unit="$1"
    property="$2"

    # --timestamp=us+utc is what makes this sub-second. systemd exposes only
    # the formatted timestamp and its monotonic counterpart, not a `*USec`
    # wall-clock property. An unsupported --timestamp= exits non-zero with
    # empty stdout, so older systemd still reaches the null return below rather
    # than emitting a second-granular or otherwise wrong boundary.
    timestamp="$(systemctl show --timestamp=us+utc --property="$property" --value "$unit" 2>/dev/null || true)"
    if [ -n "$timestamp" ] && [ "$timestamp" != "n/a" ]; then
        if ms="$(date -u -d "$timestamp" +%s%3N 2>/dev/null)"; then
            printf '%s' "$ms"
            return
        fi
    fi

    printf 'null'
}

unit_active_enter_ms_or_null() {
    unit_timestamp_ms_or_null "$1" ActiveEnterTimestamp
}

# Prints "<realtime-ms-or-null> <monotonic-usec-or-0>" for one unit timestamp
# property pair, from ONE systemctl call: reading them in two calls lets the
# unit change state in between and pair an old realtime mark with a new
# monotonic one, which would validate stale data. Output line order from
# systemctl is not contractual, so lines are classified by shape (the
# monotonic value is a bare integer; the realtime one is a formatted
# timestamp or "n/a").
unit_realtime_ms_and_monotonic_usec() {
    unit="$1"
    property="$2"
    # Concatenated via an intermediate: spawnd's template renderer treats a
    # bare dollar-brace name as an unresolved render variable and fails the
    # build, so this file must not brace plain shell variables.
    monotonic_property="$property"Monotonic
    pair_output="$(systemctl show --timestamp=us+utc \
        --property="$property,$monotonic_property" --value "$unit" 2>/dev/null || true)"
    pair_ms='null'
    pair_monotonic_usec=0
    while IFS= read -r pair_line; do
        case "$pair_line" in
            '') ;;
            *[!0-9]*)
                if [ "$pair_line" != "n/a" ]; then
                    if pair_converted="$(date -u -d "$pair_line" +%s%3N 2>/dev/null)"; then
                        pair_ms="$pair_converted"
                    fi
                fi
                ;;
            *)
                pair_monotonic_usec="$pair_line"
                ;;
        esac
    done <<PAIR_EOF
$pair_output
PAIR_EOF
    printf '%s %s' "$pair_ms" "$pair_monotonic_usec"
}

# Monotonic-ish elapsed milliseconds (/proc/uptime is CLOCK_BOOTTIME): wait
# deadlines below must not stretch when the realtime clock steps backwards.
# awk avoids the POSIX-arithmetic octal trap on zero-padded fractions, and
# %.0f rather than %d because mawk's %d saturates at 2^31-1 — after ~25 days
# of uptime a saturated "now" could never pass its own deadline and the wait
# would run into the outer kill timeout. An unreadable /proc/uptime yields 0
# and the callers skip their waits entirely, failing toward a null mark
# rather than toward the outer kill timeout.
recorder_monotonic_ms() {
    awk '{ printf "%.0f", $1 * 1000 }' /proc/uptime 2>/dev/null || printf '0'
}

write_timestamp_marker_if_number() {
    path="$1"
    value="$2"
    case "$value" in
        ''|*[!0-9]*)
            rm -f "$path"
            ;;
        *)
            printf '%s\n' "$value" | publish_file "$path"
            ;;
    esac
}

boundary_file_matches_current_boot() {
    path="$1"
    [ -r "$path" ] || return 1
    grep -q "\"boot_id\":\"$boot_id\"" "$path"
}

boot_scoped_hatch_mount_ready_at_ms_or_null() {
    path="$1"
    [ -r "$path" ] || {
        printf 'null'
        return
    }

    # The RV parent is guest-influenced. Refuse a symlink at the record, never
    # block on a FIFO, and bound the input while collecting optional telemetry.
    if ! record="$(dd if="$path" bs=4097 count=1 iflag=nofollow,nonblock status=none 2>/dev/null)" ||
        [ "${#record}" -gt 4096 ]; then
        warn "ignoring unreadable or oversized persisted hatch-mount timing in $path"
        printf 'null'
        return
    fi
    boot_id_candidate="$(printf '%s\n' "$record" | sed -n 's/.*"boot_id":"\([^"]*\)".*/\1/p' | head -n 1)"
    hatch_mount_candidate="$(printf '%s\n' "$record" | sed -n 's/.*"hatch_mount_ready_at_ms":\([0-9][0-9]*\).*/\1/p' | head -n 1)"

    if [ -z "$boot_id_candidate" ]; then
        warn "ignoring malformed persisted hatch-mount timing in $path: missing boot_id"
        printf 'null'
        return
    fi

    if [ "$boot_id_candidate" != "$boot_id" ]; then
        warn "ignoring persisted hatch-mount timing in $path: boot mismatch (stored=$boot_id_candidate current=$boot_id)"
        printf 'null'
        return
    fi

    case "$hatch_mount_candidate" in
        ''|*[!0-9]*)
            warn "ignoring malformed persisted hatch-mount timing in $path: invalid hatch_mount_ready_at_ms"
            printf 'null'
            return
            ;;
        *)
            printf '%s' "$hatch_mount_candidate"
            return
            ;;
    esac
}

# Captured before the first unit probe: the bounded PostgreSQL-ready wait far
# below must fit in what remains of this ExecStartPost's 5s timeout after all
# the probes between here and there, or a loaded PID1 could get the WHOLE
# boundary record killed instead of just a null PostgreSQL mark.
recorder_started_monotonic_ms="$(recorder_monotonic_ms)"

# Prefer hatch-image's boot-scoped guest observation. If an older image does
# not provide it, hatch.mount's own activation timestamp is still a guest-side
# mount boundary. Later readiness markers must never masquerade as the mount:
# missing guest evidence is better represented as null than as a short span.
hatch_mount_ready_at_ms="$(boot_scoped_hatch_mount_ready_at_ms_or_null "$guest_hatch_mount_boundaries")"
if [ "$hatch_mount_ready_at_ms" = "null" ]; then
    hatch_mount_ready_at_ms="$(unit_active_enter_ms_or_null hatch.mount)"
fi
hatch_seed_ready_at_ms="$(unit_active_enter_ms_or_null hatch-seed.service)"

if [ "$host_path_setup" = true ]; then
    write_timestamp_marker_if_number "$handoff_dir/hatch-mount-ready-at-ms" "$hatch_mount_ready_at_ms"
    write_timestamp_marker_if_number "$handoff_dir/home-hatch-mount-ready-at-ms" "$post_host_path_setup_ready_at_ms"
    # Keep the seed boundary even when db-preflight's later recorder fails:
    # rv-graft can still publish the mount-side prefix of the boot timeline.
    {
        printf '{'
        printf '"boot_id":"%s",' "$boot_id"
        printf '"post_host_path_setup_ready_at_ms":%s,' "$post_host_path_setup_ready_at_ms"
        printf '"hatch_mount_ready_at_ms":%s,' "$hatch_mount_ready_at_ms"
        printf '"hatch_seed_ready_at_ms":%s,' "$hatch_seed_ready_at_ms"
        printf '"home_hatch_mount_ready_at_ms":%s' "$post_host_path_setup_ready_at_ms"
        printf '}\n'
    } | publish_file "$handoff_dir/post-host-path-setup-boundaries.json"
    exit 0
fi

home_hatch_mount_ready_at_ms="$(timestamp_file_ms_or_null "$handoff_dir/home-hatch-mount-ready-at-ms")"
# When the RV mount BEGAN, not when it finished. `hatch_mount_ready_at_ms`
# above is the ActiveEnter boundary; resumption latency is measured from the
# attach, so the span needs its InactiveExit twin (same property
# `postgresql_started_at_ms` already uses). Null on an image that never
# activated the unit, which is correct -- there was no attach to measure from.
hatch_mount_attach_pair="$(unit_realtime_ms_and_monotonic_usec hatch.mount InactiveExitTimestamp)"
hatch_mount_attach_started_at_ms="${hatch_mount_attach_pair%% *}"
hatch_mount_attach_started_monotonic_usec="${hatch_mount_attach_pair##* }"
# Pre-mount LUKS-unlock window, bracketed by two device units that both re-fire
# ActiveEnter on every RV attach (unlike vault, which is boot-scoped and does not
# restart on a wake): the raw encrypted BACKING device appearing (unlock start)
# and the unlocked dm-mapper `/dev/mapper/rv` appearing (unlock done, i.e.
# luksOpen complete). These bracket the ~4s dark span before hatch.mount can
# attach. The mapper unit name is stable; the backing device is NOT (the virtio
# letter varies across the fleet), so discover it from the live mapping. All
# best-effort and fail-open like every probe above -- empty discovery, missing
# tools, or a null timestamp yields a null mark, never a failure.
rv_luks_device_ready_at_ms="$(unit_active_enter_ms_or_null dev-mapper-rv.device)"
rv_backing_device="$(dmsetup deps -o devname /dev/mapper/rv 2>/dev/null | sed -n 's/.*(\(.*\))/\1/p')"
if [ -z "$rv_backing_device" ]; then
    rv_backing_device="$(cryptsetup status rv 2>/dev/null | awk '/device:/{print $2}' | sed 's#^/dev/##')"
fi
rv_backing_device_ready_at_ms='null'
if [ -n "$rv_backing_device" ]; then
    rv_backing_device_unit="$(systemd-escape -p --suffix=device "/dev/$rv_backing_device" 2>/dev/null || true)"
    if [ -n "$rv_backing_device_unit" ]; then
        rv_backing_device_ready_at_ms="$(unit_active_enter_ms_or_null "$rv_backing_device_unit")"
    fi
fi
host_path_setup_finished_at_ms="$(unit_active_enter_ms_or_null com.hatch.host-path-setup.service)"
authd_rv_rebind_started_at_ms="$(unit_timestamp_ms_or_null com.hatch.authd-rv-rebind.service InactiveExitTimestamp)"
authd_rv_rebind_ready_at_ms="$(unit_active_enter_ms_or_null com.hatch.authd-rv-rebind.service)"
# On an already-initialized RV the unit is condition-skipped (its triggering
# ConditionPathExists=!.../PG_VERSION and ConditionPathIsSymbolicLink=
# !.../base/pgsql_tmp both fail) and never enters active. The prerequisite it
# stands for was satisfied the instant systemd evaluated those conditions and
# found nothing to converge, so record that boundary instead of losing the
# PostgreSQL split on every steady-state boot. The condition outcome is
# consulted FIRST: systemd keeps a RemainAfterExit oneshot's last
# ActiveEnterTimestamp after PartOf= stops it, so on a same-boot RV re-attach
# following a first init the stale active boundary would otherwise win over
# this attachment's skip instant. A unit that was queued and failed
# (ConditionResult=yes, never active) stays null.
if [ "$(systemctl show --property=ConditionResult --value com.hatch.db-cluster.service 2>/dev/null || true)" = "no" ]; then
    db_cluster_ready_at_ms="$(unit_timestamp_ms_or_null com.hatch.db-cluster.service ConditionTimestamp)"
else
    db_cluster_ready_at_ms="$(unit_active_enter_ms_or_null com.hatch.db-cluster.service)"
fi
# db-preflight no longer orders after PostgreSQL activation, so this recorder
# usually runs while the server is still activating, and on a same-boot RV
# re-attach systemd still reports the PREVIOUS attach's timestamps (the
# db-cluster probe above guards the same staleness class). A PostgreSQL mark
# belongs to this attach only if it is not older than the attach start;
# anything older records null rather than a stale boundary. The ready mark
# also earns a short bounded wait: on a normal wake PostgreSQL turns active
# well under two seconds after this recorder starts, the identity release
# never waits for this ExecStartPost (rv-graft polls the proof file the
# ExecStart already wrote), and before the reordering the whole unit started
# after PostgreSQL activation anyway, so waiting here keeps the start job's
# total dwell no worse than before while keeping the wake decomposition's
# PostgreSQL split observable. The wait stays inside the unit's 5s
# diagnostics timeout and only runs while the unit is genuinely activating,
# so a broken or absent server records null immediately.
# Freshness is decided on systemd's monotonic timestamps when both sides have
# one (a realtime clock step between two attaches could make a stale mark
# numerically pass a wall-clock comparison); the wall-clock comparison is the
# fallback, and an unreadable attach mark fails open. Each side's realtime and
# monotonic values come from one systemctl call (see
# unit_realtime_ms_and_monotonic_usec). Only the fresh REALTIME value is
# recorded either way.
pg_mark_fresh_or_null() {
    # $1: candidate realtime ms (or "null"); $2: the candidate's monotonic usec
    # ("" or 0 when unavailable).
    if [ "$1" = "null" ]; then
        printf 'null'
        return
    fi
    if [ -n "$2" ] && [ "$2" != "0" ] \
        && [ -n "$hatch_mount_attach_started_monotonic_usec" ] \
        && [ "$hatch_mount_attach_started_monotonic_usec" != "0" ]; then
        if [ "$2" -ge "$hatch_mount_attach_started_monotonic_usec" ] 2>/dev/null; then
            printf '%s' "$1"
        else
            printf 'null'
        fi
        return
    fi
    if [ "$hatch_mount_attach_started_at_ms" = "null" ]; then
        printf '%s' "$1"
    elif [ "$1" -ge "$hatch_mount_attach_started_at_ms" ] 2>/dev/null; then
        printf '%s' "$1"
    else
        printf 'null'
    fi
}
read_fresh_postgresql_ready_at_ms() {
    pg_ready_pair="$(unit_realtime_ms_and_monotonic_usec postgresql@18-hatch.service ActiveEnterTimestamp)"
    pg_mark_fresh_or_null "${pg_ready_pair%% *}" "${pg_ready_pair##* }"
}
db_preflight_ready_at_ms="$(date +%s%3N)"
postgresql_ready_at_ms="$(read_fresh_postgresql_ready_at_ms)"
# Deadline anchored to this recorder's start on the monotonic clock: the
# probes above already spent part of the 5s ExecStartPost budget (so a loaded
# PID1 shrinks this wait rather than pushing the whole record past the kill
# timeout), and a realtime step cannot stretch it. A zero anchor means the
# monotonic clock was unreadable; skip the wait entirely.
pg_ready_wait_deadline_ms=$((recorder_started_monotonic_ms + 3000))
while [ "$recorder_started_monotonic_ms" -gt 0 ] \
    && [ "$postgresql_ready_at_ms" = "null" ] \
    && [ "$(recorder_monotonic_ms)" -lt "$pg_ready_wait_deadline_ms" ]; do
    pg_active_state="$(systemctl show --property=ActiveState --value postgresql@18-hatch.service 2>/dev/null || true)"
    [ "$pg_active_state" = "activating" ] || break
    sleep 0.1
    postgresql_ready_at_ms="$(read_fresh_postgresql_ready_at_ms)"
done
if [ "$postgresql_ready_at_ms" = "null" ]; then
    # One last read: the unit may have flipped active between the state probe
    # and the loop exit.
    postgresql_ready_at_ms="$(read_fresh_postgresql_ready_at_ms)"
fi
pg_started_pair="$(unit_realtime_ms_and_monotonic_usec postgresql@18-hatch.service InactiveExitTimestamp)"
postgresql_started_at_ms="$(pg_mark_fresh_or_null "${pg_started_pair%% *}" "${pg_started_pair##* }")"

if [ "$home_hatch_mount_ready_at_ms" = "null" ]; then
    home_hatch_mount_ready_at_ms="$(unit_active_enter_ms_or_null home-hatch.mount)"
fi

write_timestamp_marker_if_number "$handoff_dir/postgresql-ready-at-ms" "$postgresql_ready_at_ms"
write_timestamp_marker_if_number "$handoff_dir/host-path-setup-finished-at-ms" "$host_path_setup_finished_at_ms"
write_timestamp_marker_if_number "$handoff_dir/authd-rv-rebind-started-at-ms" "$authd_rv_rebind_started_at_ms"
write_timestamp_marker_if_number "$handoff_dir/authd-rv-rebind-ready-at-ms" "$authd_rv_rebind_ready_at_ms"
write_timestamp_marker_if_number "$handoff_dir/db-cluster-ready-at-ms" "$db_cluster_ready_at_ms"
write_timestamp_marker_if_number "$handoff_dir/postgresql-started-at-ms" "$postgresql_started_at_ms"
write_timestamp_marker_if_number "$handoff_dir/db-preflight-ready-at-ms" "$db_preflight_ready_at_ms"
write_timestamp_marker_if_number "$handoff_dir/hatch-seed-ready-at-ms" "$hatch_seed_ready_at_ms"

boundaries_json="$(
    printf '{'
    printf '"boot_id":"%s",' "$boot_id"
    printf '"rv_backing_device_ready_at_ms":%s,' "$rv_backing_device_ready_at_ms"
    printf '"rv_luks_device_ready_at_ms":%s,' "$rv_luks_device_ready_at_ms"
    printf '"hatch_mount_attach_started_at_ms":%s,' "$hatch_mount_attach_started_at_ms"
    printf '"hatch_mount_ready_at_ms":%s,' "$hatch_mount_ready_at_ms"
    printf '"hatch_seed_ready_at_ms":%s,' "$hatch_seed_ready_at_ms"
    printf '"home_hatch_mount_ready_at_ms":%s,' "$home_hatch_mount_ready_at_ms"
    printf '"host_path_setup_finished_at_ms":%s,' "$host_path_setup_finished_at_ms"
    printf '"authd_rv_rebind_started_at_ms":%s,' "$authd_rv_rebind_started_at_ms"
    printf '"authd_rv_rebind_ready_at_ms":%s,' "$authd_rv_rebind_ready_at_ms"
    printf '"db_cluster_ready_at_ms":%s,' "$db_cluster_ready_at_ms"
    printf '"postgresql_started_at_ms":%s,' "$postgresql_started_at_ms"
    printf '"postgresql_ready_at_ms":%s,' "$postgresql_ready_at_ms"
    printf '"db_preflight_ready_at_ms":%s' "$db_preflight_ready_at_ms"
    printf '}'
)"
printf '%s\n' "$boundaries_json" | publish_file "$current_output"

if ! boundary_file_matches_current_boot "$output"; then
    printf '%s\n' "$boundaries_json" | publish_file "$output"
fi
clean-stop-proof.sh#!/bin/sh
# clean-stop-proof.sh — ExecStop of com.hatch.clean-stop-proof.service.
#
# Runs on the RV stop cascade AFTER postgresql@18-hatch has exited (the unit is
# Before=postgresql@18-hatch.service, so reverse stop ordering places this
# script after the PG stop job). It records the pg_controldata cluster state as
# an append-only `pg-clean.proof` line next to /hatch/data/resume/handoff-marker and
# fsyncs the resume dir, so the control plane's detach-safe check (and the
# successor's rv-graft/daemon) can prove the predecessor's PostgreSQL reached
# "shut down" cleanly before the volume was detached.
#
# NEVER-FAIL CONTRACT: this script must not wedge or fail the stop cascade.
# Every step is best-effort (missing marker dir -> create; missing
# pg_controldata or unreadable PGDATA -> record "unknown"); the script always
# exits 0 and the unit additionally invokes it with `ExecStop=-`.
set -u

pgdata="/var/lib/hatch/postgres/hatch"
resume_dir="/hatch/data/resume"
proof_file="$resume_dir/pg-clean.proof"

log() {
    echo "clean-stop-proof: $*" >&2
}

# Tolerate a missing marker dir: a first-generation RV (no predecessor handoff
# yet) still gets a proof so the detach-safe check has a uniform read.
if ! mkdir -p "$resume_dir" 2>/dev/null; then
    log "cannot create $resume_dir (RV already unmounted?); skipping proof"
    exit 0
fi

# Resolve pg_controldata across PG major versions; the cluster is pinned to 18
# today but the glob keeps the proof working across a major bump.
pg_controldata_bin=""
for cand in /usr/lib/postgresql/*/bin/pg_controldata; do
    if [ -x "$cand" ]; then
        pg_controldata_bin="$cand"
    fi
done

state_line="unknown"
if [ -e /run/hatch/postgres-mode/remote ]; then
    # Never claim a clean local PostgreSQL stop from stale files on this RV.
    # The remote server remains running; the successor uses cold recovery.
    state_line="remote"
elif [ -z "$pg_controldata_bin" ]; then
    log "pg_controldata not found under /usr/lib/postgresql/*/bin; recording state=unknown"
elif [ ! -d "$pgdata" ]; then
    log "PGDATA missing at $pgdata; recording state=unknown"
else
    # "Database cluster state: shut down" is the clean-stop signature; any
    # other state (e.g. "in production", "shut down in recovery") is recorded
    # verbatim so the reader can classify.
    state_line="$("$pg_controldata_bin" "$pgdata" 2>/dev/null \
        | sed -n 's/^Database cluster state:[[:space:]]*//p' | head -n 1)"
    if [ -z "$state_line" ]; then
        state_line="unknown"
        log "pg_controldata produced no cluster state; recording state=unknown"
    fi
fi

# The append itself is delegated to spawnd: the resume dir is read-write
# inside the runtime cell, so a root shell append/chmod here would follow a
# cell-planted symlink. spawnd opens the proof (and the epoch sidecar) with
# O_NOFOLLOW and emits the exact line grammar the successor validates.
if /opt/hatch/bin/spawnd append-clean-stop-proof --pg-state "$state_line" 2>/dev/null; then
    log "recorded pg cluster state '$state_line' in $proof_file"
else
    log "failed to append proof via spawnd (state '$state_line')"
fi

# Flush the resume dir's filesystem so the proof (and the handoff marker slots
# written by the daemon) are durable before the control plane detaches the RV.
sync -f "$resume_dir" 2>/dev/null || sync || true

exit 0
sandbox-shell#!/bin/bash -p
set -eu

# Privileged Bash mode keeps host startup hooks and imported functions inert.
# sandbox-shell — root-invoked operator shell into the runtime cell.
# Prefix --env NAME=VALUE to select literal guest variables, and --non-login
# for machine commands. The default remains a login shell for operators.
#
# RT-20: the `hatch` SSH-login plumbing that used to wrap this script
# (passwordless sudoers grant + `Match User hatch` sshd drop-in) is RETIRED;
# spawnd removes those artifacts on install and the image denies the login.
# This script is now reachable only by an identity that is ALREADY host root
# (thatch + sudo, rescue tooling). It refuses to self-elevate.
#
# Containment: before entering the cell's namespaces, the shell joins a
# dedicated leaf of the CELL's cgroup (payload/ops.scope). That placement is
# load-bearing — Sentinel's egress interception and the spawnd cell gate
# attach to the runtime-cell service cgroup, so an ops shell's network reach
# is governed exactly like any in-cell process instead of riding the host's
# ungoverned egress. The leaf name is a Sentinel contract: egress from it
# classifies as `runtime.operator_shell` (cgroup_id_is_ops_shell in
# sentinel's bpf.rs — keep the path in lockstep), so operator debug traffic
# never reads as agent behavior in telemetry, and its Ask verdicts demote to
# Deny so an operator's curl can never mint a HITL card for the user.

if [ "$(id -u)" != "0" ]; then
    echo "sandbox-shell: must be invoked as root (the hatch-login sudo path is retired)" >&2
    exit 1
fi

# Parse only wrapper prefixes; the remaining arguments belong to guest Bash.
guest_environment=()
hardened_environment=()
non_login=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --env)
            if [ "$#" -lt 2 ]; then
                echo "sandbox-shell: --env requires NAME=VALUE" >&2
                exit 1
            fi
            assignment="$2"
            shift 2
            ;;
        --env=*) assignment="${1#--env=}"; shift ;;
        --non-login) non_login=1; shift; continue ;;
        --) shift; break ;;
        *) break ;;
    esac
    if [[ ! "$assignment" =~ ^[a-zA-Z_][a-zA-Z0-9_]*= ]]; then
        echo "sandbox-shell: --env requires NAME=VALUE with a POSIX name" >&2
        exit 1
    fi
    guest_environment+=("$assignment")
    hardened_environment+=(--env "$assignment")
done

# Snapshot the caller's test selection before guest environment setup.
if ! rce_operator_exec_hardened="$(/opt/hatch/bin/hatch-cell-exec-policy operator)"; then
    echo "sandbox-shell: cell entry policy unavailable; refusing entry" >&2
    exit 1
fi
case "$rce_operator_exec_hardened" in
    0|1) ;;
    *) echo "sandbox-shell: invalid cell entry policy; refusing entry" >&2; exit 1 ;;
esac
readonly rce_operator_exec_hardened

. "${runtime_cell_dir}/runtime-cell-entry.sh"
umask 0007
if [ "$rce_operator_exec_hardened" = 0 ]; then
    . "${host_bin_dir}/guest-runtime-env.sh"
fi

leader="$(rce_runtime_cell_leader)" || exit 1

# Preserve operator attribution before the namespace transition.
rce_join_operator_cgroup "$leader" || exit 1

if [ "$non_login" = 1 ]; then
    unset BASH_ENV ENV
    set -- /bin/bash --noprofile --norc "$@"
else
    set -- /bin/bash -l "$@"
fi
if [ "$rce_operator_exec_hardened" = 1 ]; then
    rce_exec_hardened_cell "$leader" "${hardened_environment[@]}" -- "$@"
fi
if [ "${#guest_environment[@]}" -gt 0 ]; then
    set -- /usr/bin/env -- "${guest_environment[@]}" "$@"
fi
rce_enter_guest_root "$leader" "$@"
#!/bin/sh
set -eu

machine="${1:?machine}"
address_cidr="${2:?address cidr}"
gateway_ip="${3:?gateway ip}"

leader=""
for _ in $(seq 1 100); do
  leader="$(machinectl show "$machine" -p Leader --value 2>/dev/null || true)"
  if [ -n "$leader" ] && nsenter --target "$leader" --net -- ip link show host0 >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done

if [ -z "$leader" ]; then
  echo "browser-cell machine leader missing: $machine" >&2
  exit 1
fi

# --as-pid2 runs no init, so host0 is unconfigured; set its addr + default route
# inside the cell netns. Direct egress (IPv4-only): the default route points at
# the host veth gateway, and the host-side nft rule below SNATs the cell IP to
# the internet.
nsenter --target "$leader" --net -- ip addr replace "$address_cidr" dev host0
nsenter --target "$leader" --net -- ip link set host0 up
nsenter --target "$leader" --net -- ip route replace default via "$gateway_ip"

# A test VM's Sentinel browser egress lock (the lease helper's runtime drop-in
# sets this): the cell reaches only its in-cell proxy listener, so remove any
# masquerade an earlier direct start left and install none. The helper checks
# that no NAT rule covers the cell before it hands the broker that listener.
if [ "${HATCH_BROWSER_EGRESS:-}" = "sentinel" ]; then
  if nft list table ip hatch_browser_cell >/dev/null 2>&1; then
    nft delete table ip hatch_browser_cell
  fi
  exit 0
fi

cell_ip="${address_cidr%/*}"
uplink="$(
  ip -4 route show default |
    sed -n 's/.* dev \([^ ]*\).*/\1/p' |
    head -n 1
)"

if [ -z "$uplink" ]; then
  echo "browser-cell default IPv4 uplink missing; cannot install NAT" >&2
  exit 1
fi

# Own a tiny nft table instead of relying on systemd-networkd's IPMasquerade=.
# The chain is idempotently recreated to keep exactly one rule for the active
# cell IP and current uplink after restart or DHCP route churn.
nft add table ip hatch_browser_cell 2>/dev/null || true
if ! nft list chain ip hatch_browser_cell postrouting >/dev/null 2>&1; then
  nft 'add chain ip hatch_browser_cell postrouting { type nat hook postrouting priority srcnat; policy accept; }'
fi
nft flush chain ip hatch_browser_cell postrouting
nft add rule ip hatch_browser_cell postrouting ip saddr "$cell_ip" oifname "$uplink" masquerade
/var/lib/hatch-browser/rootfs-base/usr/share/hatch/chromium/webgl-allowed-domains.txtusr/share/hatch/chromium/webgl-allowed-domains.txt/run/hatch/runtime-cell/browser-webgl-allowed-domains.txtbrowser-webgl-allowed-domains.txt/run/hatch/runtime-cellbrowser_cell_webgl_policy_filebrowser_cell_webgl_policy_relpathbrowser_cell_webgl_policy_staged_filebrowser_cell_webgl_policy_staged_relpathruntime_cell_stage_dirrequire-modules.sh#!/bin/sh
set -eu

# Blacklist modules that are not needed and expand kernel attack surface.
# "install <mod> /bin/false" is stronger than "blacklist": it prevents both
# autoloading and explicit modprobe.
cat > /etc/modprobe.d/hatch-blacklist.conf <<'BLACKLIST'
# AF_ALG crypto userspace socket interface — no legitimate use on Hatch VMs,
# historically exploited (e.g. algif_aead in CVE-2023-21400 / copy.fail).
install algif_aead /bin/false
install algif_hash /bin/false
install algif_skcipher /bin/false
install algif_rng /bin/false
install af_alg /bin/false
# No IPsec or AFS/Kerberos transport.
install esp4 /bin/false
install esp6 /bin/false
install rxrpc /bin/false
BLACKLIST

# Pre-load kernel modules required by the runtime cell that will not
# be implicitly loaded by the front half of the ensure-rootfs.sh script.
runtime_cell_run_dir=/run/hatch/runtime-cell
modules_ready_file="$runtime_cell_run_dir/modules-preloaded-ok"
browser_cell_run_dir=/run/hatch/browser-cell
browser_cell_nat_modules_ready_file="$browser_cell_run_dir/nat-modules-preloaded-ok"
mkdir -p "$runtime_cell_run_dir"
mkdir -p "$browser_cell_run_dir"
rm -f "$modules_ready_file"
rm -f "$browser_cell_nat_modules_ready_file"
runtime_modules_failed=0
browser_modules_failed=0

require_runtime_module() {
    # Succeeds if already loaded or compiled in.
    if ! modprobe "$1" 2>/dev/null; then
        echo "runtime-cell module preload failed: $1" >&2
        runtime_modules_failed=1
    fi
}

require_browser_module() {
    # Succeeds if already loaded or compiled in.
    if ! modprobe "$1" 2>/dev/null; then
        echo "browser-cell NAT module preload failed: $1" >&2
        browser_modules_failed=1
    fi
}

require_runtime_module veth
require_runtime_module btrfs

# The co-located browser cell installs an explicit nft masquerade rule on its
# veth. The runtime-cell post-start script disables future module loading, so
# preload the NAT backends nft needs before that one-way lock when the HBI rootfs
# is present. The dev force marker lives under /var/lib/hatch, which may not be
# mounted yet when this early boot service runs.
# The cell's nspawn settings also overlay its managed Chrome policy directories,
# so overlayfs belongs to the same one-way preload.
if grep -qw 'jarvis_cvm=true' /proc/cmdline 2>/dev/null || [ -e /var/lib/hatch-browser/rootfs-base/usr/local/bin/entrypoint.sh ]; then
    require_browser_module overlay
    require_browser_module nf_tables
    require_browser_module nf_conntrack
    require_browser_module nf_nat
    require_browser_module nft_chain_nat
    require_browser_module nft_nat
    require_browser_module nft_masq

    if [ "$browser_modules_failed" -eq 0 ]; then
        touch "$browser_cell_nat_modules_ready_file"
    else
        echo "browser-cell NAT module preload incomplete; browser cell will stay disabled for this boot" >&2
    fi
fi

if [ "$runtime_modules_failed" -eq 0 ]; then
    touch "$modules_ready_file"
else
    echo "runtime-cell module preload incomplete; leaving module loading enabled" >&2
fi
#!/bin/sh
set -eu

rootfs=${runtime_cell_rootfs}
gateway_ip=${runtime_cell_gateway_ip}
cell_ip=${runtime_cell_address_ip}
gateway_ipv6=${runtime_cell_gateway_ipv6_ip}
cell_ipv6=${runtime_cell_address_ipv6_ip}
address_cidr=${runtime_cell_address_cidr}
address_ipv6_cidr=${runtime_cell_address_ipv6_cidr}
proxy_host=hatch-egress-proxy
no_proxy_hosts="localhost,127.0.0.1,::1,[::1],$gateway_ip,$cell_ip,$gateway_ipv6,[$gateway_ipv6],$cell_ipv6,[$cell_ipv6]"
requested_mode="${1:-}"

# Two modes. No argument runs the full rootfs bootstrap. --repair-hosts-only is a
# lightweight per-start pass (invoked by pre-start.sh) that only guarantees
# /etc/hosts and /etc/resolv.conf are regular files (not the systemd-resolved
# stub symlink) with correct perms, so nspawn's BindReadOnly of the static
# /opt/hatch/runtime-cell/etc files always lands on a real target. It writes no
# hosts content (the static bind supplies it). The former --bootstrap-only alias
# is gone; spawnd is the only caller, so there is no compat flag surface.
repair_hosts_only=0
case "$requested_mode" in
    "")
        ;;
    --repair-hosts-only)
        repair_hosts_only=1
        ;;
    *)
        echo "usage: $0 [--repair-hosts-only]" >&2
        exit 2
        ;;
esac

set -a
if [ -f "${env_file}" ]; then
    . "${env_file}"
fi
if [ -f "${env_override_file}" ]; then
    . "${env_override_file}"
fi
set +a

# Guest `root` inside the cell is host uid/gid
# ${runtime_cell_private_users_base} (systemd-nspawn PrivateUsers over a 64K
# window). Paths THIS script creates in the rootfs are chowned to it via
# guest_root_chown; the rest of the tree carries it from the image, asserted
# by assert_rootfs_ownership_is_baked below.
guest_root_uid="${runtime_cell_private_users_base}"
guest_root_gid="${runtime_cell_private_users_base}"
guest_root_owner="$guest_root_uid:$guest_root_gid"

# --- Symlink-safe rootfs traversal ---
# The rootfs is untrusted: a prior guest may have planted symlinks that,
# when followed by host root, redirect operations outside the rootfs tree.
# canonical_rootfs is derived from the resolved rootfs parent path before
# rootfs creation; all safe traversal functions require it.
canonical_rootfs=""

# Walk each component of a rootfs-relative path (e.g. "etc/hostname").
# If any component is a symlink, remove it. All safe_* wrappers pass
# relative paths and prepend canonical_rootfs internally.
ensure_not_symlink() {
    _ens_cur="$canonical_rootfs"
    _ens_rem="$1"
    while [ -n "$_ens_rem" ]; do
        _ens_comp="${_ens_rem%%/*}"
        if [ "$_ens_comp" = "$_ens_rem" ]; then
            _ens_rem=""
        else
            _ens_rem="${_ens_rem#*/}"
        fi
        [ -z "$_ens_comp" ] && continue
        _ens_next="$_ens_cur/$_ens_comp"
        if [ -L "$_ens_next" ]; then
            echo "runtime-cell bootstrap: SECURITY: removing symlink at $_ens_next -> $(readlink "$_ens_next")" >&2
            rm -f "$_ens_next"
        fi
        _ens_cur="$_ens_next"
    done
}

# --- Safe rootfs operation wrappers ---
# All paths are rootfs-relative (e.g. "etc/hostname").
#
# RT-11: the MUTATING wrappers (mkdir/write/append/touch/chmod/chown/install)
# delegate to `spawnd fsop`, which resolves the relative path beneath a held
# rootfs dirfd with openat2(RESOLVE_BENEATH|RESOLVE_NO_SYMLINKS) and acts on
# the returned descriptor. The old shape — ensure_not_symlink walking the
# path, then a second path-based chmod/chown/redirect — left the classic
# check/act gap: guest root owns every rootfs component and could re-plant a
# symlink between the walk and the act, turning these root operations into
# arbitrary host-path writes. ensure_not_symlink is retained as the REPAIR
# pass (it deletes planted links so the fd-safe op then succeeds on a fresh
# regular path) and as the guard for the residual name-ops (rm/rmdir/ln)
# fsop does not cover.

fsop() {
    /opt/hatch/bin/spawnd fsop "$@"
}

safe_mkdir() {
    _mode="$1"; shift
    for _p; do
        ensure_not_symlink "$_p"
        fsop mkdir --root "$canonical_rootfs" --path "$_p" --mode "$_mode"
    done
}

safe_write() {
    ensure_not_symlink "$1"
    fsop write --root "$canonical_rootfs" --path "$1" --mode 0644
}

safe_append() {
    _sap="$1"
    ensure_not_symlink "$_sap"
    # Append = snapshot-read + create-new-rename write. The read happens right
    # after the link repair; the WRITE is fully fd-anchored, so the worst a
    # rebuilt race can do is read (not write) through a re-planted link.
    { cat -- "$canonical_rootfs/$_sap" 2>/dev/null || true; cat; } |
        fsop write --root "$canonical_rootfs" --path "$_sap" --mode 0644
}

safe_touch() {
    for _p; do
        ensure_not_symlink "$_p"
        printf '' | fsop write --root "$canonical_rootfs" --path "$_p" --mode 0644
    done
}

safe_chmod() {
    _mode="$1"; shift
    for _p; do
        ensure_not_symlink "$_p"
        fsop chmod --root "$canonical_rootfs" --path "$_p" --mode "$_mode"
    done
}

safe_rm() {
    for _p; do
        ensure_not_symlink "$_p"
        rm -f "$canonical_rootfs/$_p"
    done
}

safe_rmdir() {
    for _p; do
        ensure_not_symlink "$_p"
        rm -rf "$canonical_rootfs/$_p"
    done
}

safe_ln() {
    _sln_parent="${2%/*}"
    if [ "$_sln_parent" != "$2" ] && [ -n "$_sln_parent" ]; then
        ensure_not_symlink "$_sln_parent"
    fi
    ln -sfn "$1" "$canonical_rootfs/$2"
}

safe_install() {
    _mode="$1"; _src="$2"; _dst="$3"
    ensure_not_symlink "$_dst"
    fsop install --root "$canonical_rootfs" --path "$_dst" --source "$_src" --mode "$_mode"
}

guest_root_chown() {
    if [ -n "$guest_root_owner" ]; then
        for _p; do
            ensure_not_symlink "$_p"
            fsop chown --root "$canonical_rootfs" --path "$_p" --owner "$guest_root_owner"
        done
    fi
}

# Guarantee /etc/hosts and /etc/resolv.conf are regular files (not the
# systemd-resolved stub symlink some rootfs-base snapshots ship) with 0644
# root-owned perms. nspawn's BindReadOnly of the static
# /opt/hatch/runtime-cell/etc files follows a symlink at the target and would
# land the bind on the symlink's /run/... target instead of /etc, so the guest
# would boot with no resolver. This writes no content — the static bind
# overmounts these files at start — and never truncates an existing regular
# file, so it is safe to run on every start via --repair-hosts-only.
ensure_resolver_files_are_regular() {
    for _rf in "etc/hosts" "etc/resolv.conf"; do
        ensure_not_symlink "$_rf"
        if [ -e "$canonical_rootfs/$_rf" ] && [ ! -f "$canonical_rootfs/$_rf" ]; then
            safe_rmdir "$_rf"
        fi
        if [ ! -f "$canonical_rootfs/$_rf" ]; then
            safe_touch "$_rf"
        fi
    done
    safe_chmod 0644 "etc/hosts" "etc/resolv.conf"
    guest_root_chown "etc/hosts" "etc/resolv.conf"
}

# Guest-side CA trust refresh. The host publishes Sentinel's egress anchor into
# the read-only /run/hatch/cell-anchors bind and owns nothing else here:
# /etc/ssl/certs is the CELL's, so the guest's own update-ca-certificates keeps
# it current. That is what lets an in-cell apt ca-certificates upgrade succeed,
# and it keeps every host-side path operation out of this cell-owned tree.
#
# Installed from BOTH modes, because --repair-hosts-only is the only one that
# runs on a healthy rootfs: the full bootstrap fires only when rootfs_is_ready
# fails, so an existing VM would otherwise never receive these units and would
# boot with stock roots and no Sentinel MITM anchor. The writes are idempotent
# and cheap, so running them every start is the correct amount.
#
# The anchor set is fixed at exactly this one name, so no shell is needed: each
# step is a plain ExecStart. Link nothing else here: see
# build-cell-trust-store.sh for why Sentinel's CA is the only anchor the cell
# may add to its trust.
#
# The .path watches the anchors directory (a DIRECTORY bind, so the host's
# republish-by-rename is visible here) and re-runs on every rotation; Sentinel
# regenerates its egress CA per boot.
install_guest_ca_trust_units() {
    # default.target, NOT multi-user.target. This script writes the guest a
    # minimal `default.target` (see the bottom of this file) precisely so the
    # cell does not boot the distro graph, and multi-user.target is therefore
    # never reached: units wired to it load, show `enabled`, and silently never
    # run. Verified on the VM — multi-user.target is inactive in a healthy cell.
    #
    # Repair mode reaches here having created only etc/, so make the unit dirs.
    safe_mkdir 0755 "etc/systemd/system" "etc/systemd/system/default.target.wants"
    guest_root_chown "etc/systemd/system" "etc/systemd/system/default.target.wants"
    safe_write "etc/systemd/system/hatch-ca-trust.service" <<'CATRUSTSVC'