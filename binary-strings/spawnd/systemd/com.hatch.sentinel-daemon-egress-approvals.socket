[Unit]
# RV-coupled socket must skip the implicit early sockets.target phase.
DefaultDependencies=no
Description=com.hatch.sentinel daemon mirror socket
ConditionPathExists=!${keep_services_down_early_marker}
After=com.hatch.host-path-setup.service
Requires=com.hatch.host-path-setup.service
# The RV owns the listener lifetime; Sentinel can stop and be socket-activated
# again when its runtime-cell dependency recovers.
PartOf=hatch-rv.target

[Socket]
FlushPending=yes
TriggerLimitIntervalSec=0
ListenStream=/run/hatch/sentinel/daemon-egress-approvals.sock
DirectoryMode=0755
SocketUser=${sentinel_user}
SocketGroup=${sentinel_group}
SocketMode=0666
FileDescriptorName=daemon-mirror
Service=com.hatch.sentinel.service
RemoveOnStop=true
ExecStartPost=+/bin/chmod 0666 /run/hatch/sentinel/daemon-egress-approvals.sock

[Install]
WantedBy=hatch-rv.target
/var/lib/hatch-runtime/var/lib/hatch-runtime/rootfs/var/lib/hatch-dev-controls/keep-services-down/opt/hatch-image/bin/run/hatch/cron-store/control.sock/etc/hatch/env.override/run/hatch/wai/wai.sock/run/hatch/whatsapp-companion/companion.sock/run/hatch/messenger/messengerd.sock/run/hatch/igd-ingress/run/hatch/igd-ingress/ingress.sock/etc/tls/credentials/fullchain.pem/etc/tls/wildcard/fullchain.pem/etc/tls/wildcard/privkey.pem/run/hatch/ingress-rev-proxy/bootstrap-fullchain.pem/run/hatch/ingress-rev-proxy/bootstrap-privkey.pem/opt/hatch/runtime-cellhtch-runtime/run/hatch/runtime-cell/runtime-cell.ready/run/hatch/ingress/runtime-cell-drainingfd8b:4f84:7d32:99::1fd8b:4f84:7d32:99::1/64fd8b:4f84:7d32:99::2/64fd8b:4f84:7d32:99::2vmvm-registry.fbinfra.net/hatch_browser_pool/hatch-browser-image:v3.90.1@sha256:238e1149c2861e46c39d1d81413fadba5a29e35d12e5147bf6bb9977931d888cvmvm-registry.fbinfra.net/hatch_browser_pool/hatch-browser-image:v3.89.2@sha256:f5df18aa9cacac876b57e88eb34eb879c400c27a43824f3bb48a64246f3e47dc/var/lib/hatch-browser/rootfs-base/run/hatch/browser-cell/nat-modules-preloaded-ok/var/lib/hatch/browser/var/lib/hatch/browser-work/profile/run/hatch/browser/run/hatch/browser-cell/egress-policy/var/lib/hatch/browser-work/pkivar/lib/hatchjarvis_homevar_lib_dircron_store_state_rootdev-controls/keep-services-downkeep_services_down_markerkeep_services_down_early_markerdev-controls/force-browser-cellforce_browser_cell_markerhost_bin_dirimage_bin_dircron_store_socketenv_override_filewhatsapp_companion_sockmessenger_sockigd_ingress_dirtls_prodca_cert_pathtls_prodca_key_pathtls_bootstrap_src_cert_pathtls_bootstrap_src_key_pathtls_bootstrap_cert_pathtls_bootstrap_key_pathruntime_cell_rootfs_parentruntime_cell_rootfsruntime_cell_machineruntime_cell_service_unitruntime_cell_vethruntime_cell_ready_fileruntime_cell_drain_fileruntime_cell_gateway_ipruntime_cell_gateway_cidrruntime_cell_address_cidrruntime_cell_address_ipruntime_cell_gateway_ipv6_ipruntime_cell_gateway_ipv6_cidr