[Unit]
Description=com.hatch.daemon meta-ai search socket
ConditionPathExists=!${keep_services_down_early_marker}

[Socket]
ExecStartPre=+/usr/bin/install -d -m 0755 -o root -g root /run/hatch
ExecStartPre=+/bin/sh -c 'if getent group hatch-w-meta-ai >/dev/null 2>&1; then exec /usr/bin/install -d -m 0750 -o root -g hatch-w-meta-ai /run/hatch/meta-ai-search; fi; exec /usr/bin/install -d -m 0700 -o root -g root /run/hatch/meta-ai-search'
ListenStream=/run/hatch/meta-ai-search/meta-ai-search.sock
Service=com.hatch.daemon.service
SocketUser=${daemon_user}
SocketGroup=${proxy_clients_group}
SocketMode=0660
RemoveOnStop=true

[Install]
WantedBy=sockets.target